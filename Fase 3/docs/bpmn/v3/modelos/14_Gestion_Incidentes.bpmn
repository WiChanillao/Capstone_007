  <collaboration id="Collab_EcoScan">
    <participant id="p14_pool1" name="14 Gestión de incidentes (TO-BE - no implementado)" processRef="p14_pool1_proc" />

  </collaboration>
  <process id="p14_pool1_proc" name="14 Gestión de incidentes (TO-BE - no implementado)" isExecutable="false">
    <documentation>TO-BE PROPUESTO (no implementado en Fase 3, commit af7d14d): no hay tabla incidente, severidad, aviso en la app, ticket automático ni post-mortem. Solo existen como insumo los logs JSON y /health. Fuente: main.py:75-88, 360-376, 594.</documentation>
    <laneSet id="p14_pool1_ls">
      <lane id="p14_pool1_lane_1" name="Monitoreo y soporte">
        <flowNodeRef>p14_s</flowNodeRef>
        <flowNodeRef>p14_m1</flowNodeRef>
        <flowNodeRef>p14_x1</flowNodeRef>
      </lane>
      <lane id="p14_pool1_lane_2" name="Equipo de guardia">
        <flowNodeRef>p14_u1</flowNodeRef>
        <flowNodeRef>p14_g1</flowNodeRef>
        <flowNodeRef>p14_u2</flowNodeRef>
        <flowNodeRef>p14_u5</flowNodeRef>
        <flowNodeRef>p14_u7</flowNodeRef>
        <flowNodeRef>p14_g4</flowNodeRef>
      </lane>
      <lane id="p14_pool1_lane_3" name="Equipo de desarrollo">
        <flowNodeRef>p14_u3</flowNodeRef>
        <flowNodeRef>p14_g0</flowNodeRef>
        <flowNodeRef>p14_u4</flowNodeRef>
        <flowNodeRef>p14_g2</flowNodeRef>
        <flowNodeRef>p14_u6</flowNodeRef>
        <flowNodeRef>p14_g3</flowNodeRef>
        <flowNodeRef>p14_u8</flowNodeRef>
        <flowNodeRef>p14_e</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p14_s" name="Alerta de monitoreo o reporte de usuario" />
    <serviceTask id="p14_m1" name="Registrar alerta con severidad preliminar" />
    <userTask id="p14_u1" name="Clasificar severidad (crítica, alta o baja)" />
    <exclusiveGateway id="p14_g1" name="¿Es crítica?" />
    <userTask id="p14_u2" name="Notificar al equipo y publicar aviso en la app" />
    <userTask id="p14_u3" name="Crear ticket y priorizar en el backlog" />
    <exclusiveGateway id="p14_g0" />
    <userTask id="p14_u4" name="Diagnosticar causa (logs, métricas, /health)" />
    <exclusiveGateway id="p14_g2" name="¿Mitigable sin cambiar código?" />
    <userTask id="p14_u5" name="Aplicar mitigación (reinicio, rollback, configuración)" />
    <userTask id="p14_u6" name="Desarrollar y probar corrección (hotfix)" />
    <exclusiveGateway id="p14_g3" />
    <userTask id="p14_u7" name="Verificar recuperación (health OK y prueba manual)" />
    <exclusiveGateway id="p14_g4" name="¿Servicio recuperado?" />
    <serviceTask id="p14_x1" name="Retirar aviso y confirmar normalidad" />
    <userTask id="p14_u8" name="Registrar post-mortem y acciones preventivas" />
    <endEvent id="p14_e" name="Fin: incidente cerrado" />
    <sequenceFlow id="p14_sf1" sourceRef="p14_s" targetRef="p14_m1" />
    <sequenceFlow id="p14_sf2" sourceRef="p14_m1" targetRef="p14_u1" />
