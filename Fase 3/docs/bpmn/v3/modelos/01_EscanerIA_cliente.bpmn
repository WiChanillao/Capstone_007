<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://ecoscan.example/bpmn" id="Definitions_EcoScan" name="EcoScan Chile - Escáner IA: escanear un residuo (cliente, extendido)">
  <collaboration id="Collab_EcoScan">
    <participant id="p01_pool1" name="01 Escáner IA: escanear un residuo (AS-IS Fase 3 + TO-BE)" processRef="p01_pool1_proc" />
    <participant id="p01_pool2" name="02 Servicio de inferencia POST /predict (ver modelo 02)" />
    <messageFlow id="p01_mf1" name="Imagen (multipart)" sourceRef="p01_a7" targetRef="p01_pool2" />
    <messageFlow id="p01_mf2" name="Respuesta JSON" sourceRef="p01_pool2" targetRef="p01_w1" />
  </collaboration>
  <process id="p01_pool1_proc" name="01 Escáner IA: escanear un residuo (AS-IS Fase 3 + TO-BE)" isExecutable="false">
    <documentation>AS-IS VERIFICADO (Fase 3, commit af7d14d): la app muestra 5 pestañas (Menú Principal mas 4 módulos), permite cámara o archivo, convierte HEIC/HEIF a JPG, valida hasta 10 MB, envía POST /predict con AbortController de 10 s y muestra resultados por material con contenedor, pasos y confianza; admite varios materiales por foto. Fuente: App.jsx:617-674, 723-854 y main.py:405-609. TO-BE PROPUESTO: mensaje dedicado de timeout con botón de reintento, error específico de archivo no soportado, consentimiento previo y enlaces y pasos leídos desde MySQL en lugar de texto hardcodeado.</documentation>
    <laneSet id="p01_pool1_ls">
      <lane id="p01_pool1_lane_1" name="Usuario">
        <flowNodeRef>p01_s</flowNodeRef>
        <flowNodeRef>p01_u1</flowNodeRef>
        <flowNodeRef>p01_g1</flowNodeRef>
        <flowNodeRef>p01_u3</flowNodeRef>
        <flowNodeRef>p01_u2</flowNodeRef>
        <flowNodeRef>p01_g3</flowNodeRef>
        <flowNodeRef>p01_u5</flowNodeRef>
        <flowNodeRef>p01_g6</flowNodeRef>
        <flowNodeRef>p01_u6</flowNodeRef>
        <flowNodeRef>p01_u7</flowNodeRef>
        <flowNodeRef>p01_e4</flowNodeRef>
      </lane>
      <lane id="p01_pool1_lane_2" name="App EcoScan Chile (React + Vite)">
        <flowNodeRef>p01_a1</flowNodeRef>
        <flowNodeRef>p01_ga</flowNodeRef>
        <flowNodeRef>p01_b1</flowNodeRef>
        <flowNodeRef>p01_b2</flowNodeRef>
        <flowNodeRef>p01_a2</flowNodeRef>
        <flowNodeRef>p01_g2</flowNodeRef>
        <flowNodeRef>p01_a3</flowNodeRef>
        <flowNodeRef>p01_e0</flowNodeRef>
        <flowNodeRef>p01_a4</flowNodeRef>
        <flowNodeRef>p01_g4</flowNodeRef>
        <flowNodeRef>p01_a5</flowNodeRef>
        <flowNodeRef>p01_e1</flowNodeRef>
        <flowNodeRef>p01_a6</flowNodeRef>
        <flowNodeRef>p01_a7</flowNodeRef>
        <flowNodeRef>p01_bt</flowNodeRef>
        <flowNodeRef>p01_w1</flowNodeRef>
        <flowNodeRef>p01_g5</flowNodeRef>
        <flowNodeRef>p01_a9</flowNodeRef>
        <flowNodeRef>p01_a10</flowNodeRef>
        <flowNodeRef>p01_a8</flowNodeRef>
        <flowNodeRef>p01_e2</flowNodeRef>
        <flowNodeRef>p01_e3</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p01_s" name="Usuario abre EcoScan Chile" />
    <serviceTask id="p01_a1" name="Cargar app y mostrar 5 pestañas (Menú Principal + 4 módulos)" />
    <parallelGateway id="p01_ga" />
    <serviceTask id="p01_b1" name="Mostrar banner de impacto ambiental RM"><documentation>Tabla banner_impacto (RF-11)</documentation></serviceTask>
    <intermediateCatchEvent id="p01_b2" name="Rotación o clic en 'Siguiente'"><timerEventDefinition /></intermediateCatchEvent>
    <userTask id="p01_u1" name="Presionar 'Subir Imagen / Tomar Foto'" />
    <exclusiveGateway id="p01_g1" name="¿Origen de la imagen?" />
    <serviceTask id="p01_a2" name="Solicitar permiso de cámara al navegador" />
    <exclusiveGateway id="p01_g2" name="¿Permiso concedido?" />
    <serviceTask id="p01_a3" name="Informar: usar galería de archivos" />
    <endEvent id="p01_e0" name="Fin: sin cámara" />
    <userTask id="p01_u3" name="Tomar foto con la cámara" />
    <userTask id="p01_u2" name="Elegir imagen desde archivo" />
    <exclusiveGateway id="p01_g3" />
    <serviceTask id="p01_a4" name="Validar tipo y tamaño en el cliente (10 MB); convertir HEIC/HEIF a JPG" />
    <exclusiveGateway id="p01_g4" name="¿Archivo válido?" />
    <serviceTask id="p01_a5" name="Mostrar error: archivo no soportado" />
    <endEvent id="p01_e1" name="Fin: archivo rechazado" />
    <serviceTask id="p01_a6" name="Mostrar vista previa de la imagen" />
    <serviceTask id="p01_a7" name="Enviar a POST /predict con AbortController de 10 s y mostrar 'Esperando imagen...'" />
    <boundaryEvent id="p01_bt" name="Timeout 10 s" attachedToRef="p01_a7" cancelActivity="true"><timerEventDefinition /></boundaryEvent>
    <intermediateCatchEvent id="p01_w1" name="Respuesta JSON del servicio"><messageEventDefinition /></intermediateCatchEvent>
    <exclusiveGateway id="p01_g5" name="¿Resultado de la respuesta?" />
    <serviceTask id="p01_a9" name="Mostrar resultados por material (contenedor, pasos y confianza)" />
    <serviceTask id="p01_a10" name="Mostrar aviso: repetir foto (sin detecciones o confianza baja)" />
    <serviceTask id="p01_a8" name="[TO-BE] Mostrar error de servicio / tiempo agotado y ofrecer reintento" />
    <endEvent id="p01_e2" name="Fin: usuario repite captura" />
    <endEvent id="p01_e3" name="Fin: error informado" />
    <userTask id="p01_u5" name="Revisar contenedor y pasos de preparación" />
    <exclusiveGateway id="p01_g6" name="¿Qué desea hacer?" />
    <userTask id="p01_u6" name="Alternar '¿Cómo Reciclar?' / '¿Cómo Reutilizar?'" />
    <userTask id="p01_u7" name="Abrir enlace externo (texto hardcodeado)" />
    <endEvent id="p01_e4" name="Fin: usuario informado" />
