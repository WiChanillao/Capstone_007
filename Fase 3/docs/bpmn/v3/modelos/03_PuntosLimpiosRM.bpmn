<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://ecoscan.example/bpmn" id="Definitions_EcoScan" name="EcoScan Chile - Puntos Limpios RM: buscar un punto de reciclaje (extendido)">
  <collaboration id="Collab_EcoScan">
    <participant id="p03_pool1" name="03 Puntos Limpios RM: buscar un punto (AS-IS Fase 3)" processRef="p03_pool1_proc" />

  </collaboration>
  <process id="p03_pool1_proc" name="03 Puntos Limpios RM: buscar un punto (AS-IS Fase 3)" isExecutable="false">
    <documentation>AS-IS VERIFICADO (Fase 3, commit af7d14d): 35 puntos limpios desde MySQL con 55 relaciones punto-material, filtros por comuna y material, cálculo de abierto ahora, orden por distancia, mapa Leaflet con 3 proveedores y enlace de cómo llegar. Fuente: rutas_db.py:134-155, App.jsx:331-353, 595-610, MapaPuntos.jsx:8-190, 02_seed.sql:139-184. TO-BE PROPUESTO: curaduría de datos, confirmar los 25 puntos externos y permitir reportar datos incorrectos (proceso 08).</documentation>
    <laneSet id="p03_pool1_ls">
      <lane id="p03_pool1_lane_1" name="Usuario">
        <flowNodeRef>p03_s</flowNodeRef>
        <flowNodeRef>p03_u1</flowNodeRef>
        <flowNodeRef>p03_u2</flowNodeRef>
        <flowNodeRef>p03_g1</flowNodeRef>
        <flowNodeRef>p03_u3</flowNodeRef>
        <flowNodeRef>p03_g2</flowNodeRef>
        <flowNodeRef>p03_u4</flowNodeRef>
        <flowNodeRef>p03_g3</flowNodeRef>
        <flowNodeRef>p03_g4</flowNodeRef>
        <flowNodeRef>p03_u5</flowNodeRef>
        <flowNodeRef>p03_u6</flowNodeRef>
        <flowNodeRef>p03_e1</flowNodeRef>
      </lane>
      <lane id="p03_pool1_lane_2" name="App EcoScan Chile">
        <flowNodeRef>p03_a1</flowNodeRef>
        <flowNodeRef>p03_g0</flowNodeRef>
        <flowNodeRef>p03_a0</flowNodeRef>
        <flowNodeRef>p03_e0</flowNodeRef>
        <flowNodeRef>p03_a2</flowNodeRef>
        <flowNodeRef>p03_a3</flowNodeRef>
      </lane>
      <lane id="p03_pool1_lane_3" name="Fuente de datos de puntos limpios">
        <flowNodeRef>p03_d1</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p03_s" name="Necesita reciclar un residuo" />
    <userTask id="p03_u1" name="Abrir pestaña 'Puntos Limpios RM'" />
    <serviceTask id="p03_a1" name="Solicitar listado de puntos limpios" />
    <serviceTask id="p03_d1" name="Entregar 35 puntos desde MySQL (10 propios + 25 externos por confirmar)"><documentation>SELECT punto_limpio JOIN comuna, horario_punto, punto_material</documentation></serviceTask>
    <exclusiveGateway id="p03_g0" name="¿Datos disponibles?" />
    <serviceTask id="p03_a0" name="Mostrar error: no se pudo cargar el listado" />
    <endEvent id="p03_e0" name="Fin: listado no disponible" />
    <serviceTask id="p03_a2" name="Mostrar tarjetas de todos los puntos (filtro 'Todas')" />
    <userTask id="p03_u2" name="Revisar filtros por comuna y material" />
    <exclusiveGateway id="p03_g1" name="¿Filtrar por comuna?" />
    <userTask id="p03_u3" name="Seleccionar filtro de comuna o material" />
    <serviceTask id="p03_a3" name="Filtrar tarjetas y ordenar por distancia (sin recargar la página)" />
    <exclusiveGateway id="p03_g2" />
    <userTask id="p03_u4" name="Revisar tarjeta: dirección, horario y materiales aceptados" />
    <exclusiveGateway id="p03_g3" name="¿Acepta el material que quiero reciclar?" />
    <exclusiveGateway id="p03_g4" name="¿Está abierto ahora? (cálculo automático)" />
    <userTask id="p03_u5" name="Abrir mapa Leaflet y enlace de cómo llegar" />
    <userTask id="p03_u6" name="Acudir al punto limpio y entregar el residuo" />
    <endEvent id="p03_e1" name="Fin: punto limpio identificado y residuo entregado" />
    <sequenceFlow id="p03_sf1" sourceRef="p03_s" targetRef="p03_u1" />
    <sequenceFlow id="p03_sf2" sourceRef="p03_u1" targetRef="p03_a1" />
    <sequenceFlow id="p03_sf3" sourceRef="p03_a1" targetRef="p03_d1" />
