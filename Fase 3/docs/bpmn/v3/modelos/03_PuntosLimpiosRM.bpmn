    <sequenceFlow id="p03_sf15" sourceRef="p03_u4" targetRef="p03_g3" />
    <sequenceFlow id="p03_sf16" name="Sí" sourceRef="p03_g3" targetRef="p03_g4" />
    <sequenceFlow id="p03_sf17" name="No: probar otra comuna" sourceRef="p03_g3" targetRef="p03_g1" />
    <sequenceFlow id="p03_sf18" name="Sí" sourceRef="p03_g4" targetRef="p03_u5" />
    <sequenceFlow id="p03_sf19" name="No: buscar otro punto" sourceRef="p03_g4" targetRef="p03_g1" />
    <sequenceFlow id="p03_sf20" sourceRef="p03_u5" targetRef="p03_u6" />
    <sequenceFlow id="p03_sf21" sourceRef="p03_u6" targetRef="p03_e1" />
  </process>
