<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://ecoscan.example/bpmn" id="Definitions_EcoScan" name="EcoScan Chile - Gestión del catálogo de materiales y contenedores">
  <collaboration id="Collab_EcoScan">
    <participant id="p07_pool1" name="07 Gestión del catálogo (TO-BE - hoy solo lectura y textos hardcodeados)" processRef="p07_pool1_proc" />

  </collaboration>
  <process id="p07_pool1_proc" name="07 Gestión del catálogo (TO-BE - hoy solo lectura y textos hardcodeados)" isExecutable="false">
    <documentation>AS-IS VERIFICADO (Fase 3, commit af7d14d): las tablas material, contenedor, instruccion, paso_instruccion, recurso_externo y banner_impacto están sembradas y se leen por /db/materiales, /db/materiales/{id}/instrucciones y /db/banners, pero el frontend solo usa el color del contenedor y muestra pasos y enlaces hardcodeados en App.jsx:71-184. Fuente: 01_schema.sql:33-76, 160-287, rutas_db.py:60-90, App.jsx:533-546. TO-BE PROPUESTO: panel de administración con roles, validación de completitud, vista previa, aprobación, transacción y auditoría, y que el frontend consuma la API.</documentation>
    <laneSet id="p07_pool1_ls">
      <lane id="p07_pool1_lane_1" name="Administrador de contenido">
        <flowNodeRef>p07_s</flowNodeRef>
        <flowNodeRef>p07_u1</flowNodeRef>
        <flowNodeRef>p07_u2</flowNodeRef>
        <flowNodeRef>p07_u3</flowNodeRef>
        <flowNodeRef>p07_ga</flowNodeRef>
        <flowNodeRef>p07_u4</flowNodeRef>
        <flowNodeRef>p07_u5</flowNodeRef>
        <flowNodeRef>p07_u6</flowNodeRef>
        <flowNodeRef>p07_gj</flowNodeRef>
        <flowNodeRef>p07_u7</flowNodeRef>
      </lane>
      <lane id="p07_pool1_lane_2" name="Plataforma de administración">
        <flowNodeRef>p07_p1</flowNodeRef>
        <flowNodeRef>p07_g1</flowNodeRef>
        <flowNodeRef>p07_e1</flowNodeRef>
        <flowNodeRef>p07_p2</flowNodeRef>
        <flowNodeRef>p07_g2</flowNodeRef>
        <flowNodeRef>p07_p3</flowNodeRef>
        <flowNodeRef>p07_p4</flowNodeRef>
        <flowNodeRef>p07_e2</flowNodeRef>
      </lane>
      <lane id="p07_pool1_lane_3" name="Revisor">
        <flowNodeRef>p07_r1</flowNodeRef>
        <flowNodeRef>p07_g3</flowNodeRef>
      </lane>
      <lane id="p07_pool1_lane_4" name="Base de datos">
        <flowNodeRef>p07_d1</flowNodeRef>
        <flowNodeRef>p07_d2</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p07_s" name="Material nuevo o corrección requerida" />
    <userTask id="p07_u1" name="Iniciar sesión en el panel de administración" />
    <serviceTask id="p07_p1" name="Validar credenciales y rol 'administrador'"><documentation>SELECT usuario, rol</documentation></serviceTask>
    <exclusiveGateway id="p07_g1" name="¿Autenticado?" />
    <endEvent id="p07_e1" name="Fin: acceso denegado" />
    <userTask id="p07_u2" name="Crear o editar material (nombre, código, ¿clasificable por IA?)" />
    <userTask id="p07_u3" name="Asignar contenedor de reciclaje (color)" />
    <parallelGateway id="p07_ga" />
    <userTask id="p07_u4" name="Redactar pasos de '¿Cómo Reciclar?'" />
    <userTask id="p07_u5" name="Redactar pasos de '¿Cómo Reutilizar?'" />
    <userTask id="p07_u6" name="Asociar recursos externos (MMA, TriCiclos…)" />
    <parallelGateway id="p07_gj" />
    <serviceTask id="p07_p2" name="Validar completitud: contenedor y ≥ 1 paso por modo" />
    <exclusiveGateway id="p07_g2" name="¿Catálogo completo?" />
    <serviceTask id="p07_p3" name="Generar vista previa del resultado del escáner" />
    <userTask id="p07_u7" name="Revisar vista previa y enviar a aprobación" />
    <userTask id="p07_r1" name="Aprobar o rechazar el cambio" />
    <exclusiveGateway id="p07_g3" name="¿Aprobado?" />
    <serviceTask id="p07_d1" name="Guardar material, pasos y recursos (transacción)"><documentation>INSERT/UPDATE material, instruccion, paso_instruccion, instruccion_recurso</documentation></serviceTask>
    <serviceTask id="p07_d2" name="Registrar auditoría (usuario, antes y después)"><documentation>INSERT auditoria_cambio</documentation></serviceTask>
    <serviceTask id="p07_p4" name="Publicar nueva versión del catálogo" />
    <endEvent id="p07_e2" name="Fin: catálogo actualizado" />
    <sequenceFlow id="p07_sf1" sourceRef="p07_s" targetRef="p07_u1" />
    <sequenceFlow id="p07_sf2" sourceRef="p07_u1" targetRef="p07_p1" />
    <sequenceFlow id="p07_sf3" sourceRef="p07_p1" targetRef="p07_g1" />
    <sequenceFlow id="p07_sf4" name="No" sourceRef="p07_g1" targetRef="p07_e1" />
    <sequenceFlow id="p07_sf5" name="Sí" sourceRef="p07_g1" targetRef="p07_u2" />
