    <sequenceFlow id="p07_sf15" sourceRef="p07_p2" targetRef="p07_g2" />
    <sequenceFlow id="p07_sf16" name="Incompleto: completar datos" sourceRef="p07_g2" targetRef="p07_u2" />
    <sequenceFlow id="p07_sf17" name="Sí" sourceRef="p07_g2" targetRef="p07_p3" />
    <sequenceFlow id="p07_sf18" sourceRef="p07_p3" targetRef="p07_u7" />
    <sequenceFlow id="p07_sf19" sourceRef="p07_u7" targetRef="p07_r1" />
    <sequenceFlow id="p07_sf20" sourceRef="p07_r1" targetRef="p07_g3" />
    <sequenceFlow id="p07_sf21" name="Rechazado: corregir" sourceRef="p07_g3" targetRef="p07_u2" />
    <sequenceFlow id="p07_sf22" name="Sí" sourceRef="p07_g3" targetRef="p07_d1" />
    <sequenceFlow id="p07_sf23" sourceRef="p07_d1" targetRef="p07_d2" />
    <sequenceFlow id="p07_sf24" sourceRef="p07_d2" targetRef="p07_p4" />
    <sequenceFlow id="p07_sf25" sourceRef="p07_p4" targetRef="p07_e2" />
  </process>
