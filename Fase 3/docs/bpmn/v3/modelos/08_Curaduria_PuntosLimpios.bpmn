<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://ecoscan.example/bpmn" id="Definitions_EcoScan" name="EcoScan Chile - Curaduría y actualización del catálogo de puntos limpios">
  <collaboration id="Collab_EcoScan">
    <participant id="p08_pool1" name="08 Curaduría de puntos limpios (TO-BE - no implementado)" processRef="p08_pool1_proc" />

  </collaboration>
  <process id="p08_pool1_proc" name="08 Curaduría de puntos limpios (TO-BE - no implementado)" isExecutable="false">
    <documentation>TO-BE PROPUESTO (no implementado en Fase 3, commit af7d14d): no hay ETL, staging, detección de duplicados, auditoría ni tabla reporte_dato_punto. Hoy se siembran 35 puntos, de los cuales 25 externos están marcados por confirmar y tienen coordenadas aproximadas. Fuente: 02_seed.sql:139-184, MapaPuntos.jsx:156-190.</documentation>
    <laneSet id="p08_pool1_ls">
      <lane id="p08_pool1_lane_1" name="Equipo de curaduría de datos">
        <flowNodeRef>p08_s</flowNodeRef>
        <flowNodeRef>p08_e1</flowNodeRef>
        <flowNodeRef>p08_e2</flowNodeRef>
        <flowNodeRef>p08_e3</flowNodeRef>
        <flowNodeRef>p08_e4</flowNodeRef>
        <flowNodeRef>p08_g2</flowNodeRef>
        <flowNodeRef>p08_e5</flowNodeRef>
        <flowNodeRef>p08_e7</flowNodeRef>
        <flowNodeRef>p08_g3</flowNodeRef>
        <flowNodeRef>p08_e9</flowNodeRef>
      </lane>
      <lane id="p08_pool1_lane_2" name="Plataforma / proceso ETL">
        <flowNodeRef>p08_p1</flowNodeRef>
        <flowNodeRef>p08_p2</flowNodeRef>
        <flowNodeRef>p08_p3</flowNodeRef>
        <flowNodeRef>p08_g1</flowNodeRef>
        <flowNodeRef>p08_p4</flowNodeRef>
        <flowNodeRef>p08_p5</flowNodeRef>
        <flowNodeRef>p08_e6</flowNodeRef>
        <flowNodeRef>p08_s2</flowNodeRef>
        <flowNodeRef>p08_p6</flowNodeRef>
      </lane>
      <lane id="p08_pool1_lane_3" name="Operador o municipio (externo)">
        <flowNodeRef>p08_x1</flowNodeRef>
      </lane>
      <lane id="p08_pool1_lane_4" name="Base de datos">
        <flowNodeRef>p08_d1</flowNodeRef>
        <flowNodeRef>p08_d2</flowNodeRef>
        <flowNodeRef>p08_d3</flowNodeRef>
        <flowNodeRef>p08_e8</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p08_s" name="Revisión trimestral"><timerEventDefinition /></startEvent>
    <userTask id="p08_e1" name="Identificar fuentes oficiales (MMA, municipios)" />
    <userTask id="p08_e2" name="Solicitar o descargar listado actualizado" />
    <userTask id="p08_x1" name="Entregar listado de puntos, horarios y materiales" />
    <serviceTask id="p08_p1" name="Normalizar campos (comuna, dirección, horario, materiales)" />
    <serviceTask id="p08_p2" name="Geocodificar direcciones (latitud / longitud)" />
    <serviceTask id="p08_p3" name="Detectar duplicados y conflictos con los datos vigentes" />
    <exclusiveGateway id="p08_g1" name="¿Datos válidos?" />
    <userTask id="p08_e3" name="Corregir o consultar al operador" />
    <serviceTask id="p08_d1" name="Cargar el lote a staging" />
    <userTask id="p08_e4" name="Revisar diferencias (altas, bajas y cambios)" />
    <exclusiveGateway id="p08_g2" name="¿Lote aprobado?" />
    <endEvent id="p08_e5" name="Fin: lote rechazado" />
    <serviceTask id="p08_d2" name="Publicar en punto_limpio y registrar auditoría"><documentation>UPSERT punto_limpio, horario_punto, punto_material; INSERT auditoria_cambio</documentation></serviceTask>
    <serviceTask id="p08_p4" name="Actualizar el listado visible en la app" />
    <serviceTask id="p08_p5" name="Programar la próxima verificación trimestral" />
    <endEvent id="p08_e6" name="Fin: puntos limpios actualizados" />
    <startEvent id="p08_s2" name="Reporte de usuario: dato incorrecto"><messageEventDefinition /></startEvent>
    <serviceTask id="p08_p6" name="Registrar reporte (punto, campo, descripción)"><documentation>INSERT reporte_dato_punto</documentation></serviceTask>
    <userTask id="p08_e7" name="Verificar el dato con el operador" />
    <exclusiveGateway id="p08_g3" name="¿Reporte procedente?" />
    <serviceTask id="p08_d3" name="Corregir dato y marcar reporte como resuelto" />
    <endEvent id="p08_e8" name="Fin: reporte resuelto" />
    <endEvent id="p08_e9" name="Fin: reporte descartado" />
    <sequenceFlow id="p08_sf1" sourceRef="p08_s" targetRef="p08_e1" />
    <sequenceFlow id="p08_sf2" sourceRef="p08_e1" targetRef="p08_e2" />
