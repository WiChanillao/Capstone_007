    <sequenceFlow id="p09_sf17" sourceRef="p09_t3" targetRef="p09_g4" />
    <sequenceFlow id="p09_sf18" sourceRef="p09_t4" targetRef="p09_g4" />
    <sequenceFlow id="p09_sf19" sourceRef="p09_v4" targetRef="p09_g4" />
    <sequenceFlow id="p09_sf20" name="Sí" sourceRef="p09_g4" targetRef="p09_v2" />
    <sequenceFlow id="p09_sf21" name="No" sourceRef="p09_g4" targetRef="p09_v8" />
    <sequenceFlow id="p09_sf22" sourceRef="p09_v8" targetRef="p09_e" />
  </process>
