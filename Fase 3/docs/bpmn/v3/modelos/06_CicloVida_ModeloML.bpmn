    <sequenceFlow id="p06_sf24" sourceRef="p06_o4" targetRef="p06_o5" />
    <sequenceFlow id="p06_sf25" sourceRef="p06_o5" targetRef="p06_t1" />
    <sequenceFlow id="p06_sf26" sourceRef="p06_t1" targetRef="p06_g5" />
    <sequenceFlow id="p06_sf27" name="No" sourceRef="p06_g5" targetRef="p06_e3" />
    <sequenceFlow id="p06_sf28" name="Sí" sourceRef="p06_g5" targetRef="p06_x1" />
    <sequenceFlow id="p06_sf29" name="Nuevo ciclo" sourceRef="p06_x1" targetRef="p06_d2" />
  </process>
