<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://ecoscan.example/bpmn" id="Definitions_EcoScan" name="EcoScan Chile - Desafío Verde RM: completar los hábitos de la semana (extendido)">
  <collaboration id="Collab_EcoScan">
    <participant id="p05_pool1" name="05 Desafío Verde RM: hábitos automáticos y trivia (AS-IS Fase 3) + cierre semanal (TO-BE)" processRef="p05_pool1_proc" />
    <participant id="p05_pool2" name="05b Cierre semanal automático (TO-BE - no implementado)" processRef="p05_pool2_proc" />

  </collaboration>
  <process id="p05_pool1_proc" name="05 Desafío Verde RM: hábitos automáticos y trivia (AS-IS Fase 3) + cierre semanal (TO-BE)" isExecutable="false">
    <documentation>AS-IS VERIFICADO (Fase 3, commit af7d14d): NO hay 4 casillas marcables. El cumplimiento de los 4 hábitos se deriva automáticamente de los escaneos (reglas 3/3/1 y los 3 materiales) y se complementa con trivia de 25 preguntas, 5 por ronda; hay mensaje de felicitación al 100 % pero sin insignias persistentes. El endpoint PUT de hábitos es un vestigio que la UI ya no usa. Fuente: App.jsx:355-362, 695-721, trivia.js, rutas_db.py:323-330. TO-BE PROPUESTO: cierre semanal, racha, insignias persistentes, configuración de hábitos por administrador y coherencia entre reglas y descripciones sembradas.</documentation>
    <laneSet id="p05_pool1_ls">
      <lane id="p05_pool1_lane_1" name="Usuario">
        <flowNodeRef>p05_s</flowNodeRef>
        <flowNodeRef>p05_u1</flowNodeRef>
      </lane>
      <lane id="p05_pool1_lane_2" name="App EcoScan Chile">
        <flowNodeRef>p05_a1</flowNodeRef>
        <flowNodeRef>p05_a2</flowNodeRef>
        <flowNodeRef>p05_a3</flowNodeRef>
        <flowNodeRef>p05_a4</flowNodeRef>
        <flowNodeRef>p05_g3</flowNodeRef>
        <flowNodeRef>p05_a5</flowNodeRef>
        <flowNodeRef>p05_e1</flowNodeRef>
        <flowNodeRef>p05_g4</flowNodeRef>
        <flowNodeRef>p05_a8</flowNodeRef>
        <flowNodeRef>p05_e3</flowNodeRef>
        <flowNodeRef>p05_a6</flowNodeRef>
        <flowNodeRef>p05_a7</flowNodeRef>
        <flowNodeRef>p05_e2</flowNodeRef>
      </lane>
      <lane id="p05_pool1_lane_3" name="Persistencia (TO-BE: BD con semana e insignias)">
        <flowNodeRef>p05_d1</flowNodeRef>
        <flowNodeRef>p05_g1</flowNodeRef>
        <flowNodeRef>p05_d2</flowNodeRef>
        <flowNodeRef>p05_g2</flowNodeRef>
        <flowNodeRef>p05_d3</flowNodeRef>
        <flowNodeRef>p05_d4</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p05_s" name="Abrir 'Desafío Verde RM'" />
    <serviceTask id="p05_a1" name="[TO-BE] Determinar la semana vigente" />
    <serviceTask id="p05_d1" name="[TO-BE] Buscar participación de la sesión en la semana"><documentation>SELECT participacion_desafio</documentation></serviceTask>
    <exclusiveGateway id="p05_g1" name="[TO-BE] ¿Existe participación?" />
    <serviceTask id="p05_d2" name="[TO-BE] Crear participación con 0 % de progreso"><documentation>INSERT participacion_desafio, habito_cumplido</documentation></serviceTask>
    <exclusiveGateway id="p05_g2" />
    <serviceTask id="p05_a2" name="Mostrar 4 hábitos con estado automático y % de progreso" />
    <userTask id="p05_u1" name="[TO-BE] Marcar o desmarcar un hábito manualmente" />
    <serviceTask id="p05_a3" name="[TO-BE] Registrar el cambio manual del hábito" />
    <serviceTask id="p05_d3" name="[TO-BE] Persistir hábito cumplido (brecha B-4)"><documentation>UPDATE habito_cumplido</documentation></serviceTask>
    <serviceTask id="p05_a4" name="Calcular progreso = hábitos cumplidos automáticamente / 4 × 100 %" />
    <exclusiveGateway id="p05_g3" name="¿Progreso = 100 %?" />
    <serviceTask id="p05_a5" name="Mostrar % actualizado (0 / 25 / 50 / 75 / 100 %)" />
    <endEvent id="p05_e1" name="Fin: progreso guardado" />
    <exclusiveGateway id="p05_g4" name="¿Insignia ya otorgada esta semana?" />
    <serviceTask id="p05_a8" name="[TO-BE] Mostrar insignia de semanas anteriores" />
    <endEvent id="p05_e3" name="Fin: sin cambios" />
    <serviceTask id="p05_a6" name="Mostrar mensaje de felicitación al completar 100 %" />
    <serviceTask id="p05_d4" name="[TO-BE] Registrar insignia obtenida"><documentation>INSERT insignia_obtenida</documentation></serviceTask>
    <serviceTask id="p05_a7" name="Mostrar insignia y mensaje de felicitación" />
    <endEvent id="p05_e2" name="Fin: insignia otorgada" />
    <sequenceFlow id="p05_sf1" sourceRef="p05_s" targetRef="p05_a1" />
    <sequenceFlow id="p05_sf2" sourceRef="p05_a1" targetRef="p05_d1" />
    <sequenceFlow id="p05_sf3" sourceRef="p05_d1" targetRef="p05_g1" />
    <sequenceFlow id="p05_sf4" name="Sí" sourceRef="p05_g1" targetRef="p05_g2" />
    <sequenceFlow id="p05_sf5" name="No" sourceRef="p05_g1" targetRef="p05_d2" />
    <sequenceFlow id="p05_sf6" sourceRef="p05_d2" targetRef="p05_g2" />
    <sequenceFlow id="p05_sf7" sourceRef="p05_g2" targetRef="p05_a2" />
    <sequenceFlow id="p05_sf8" sourceRef="p05_a2" targetRef="p05_u1" />
    <sequenceFlow id="p05_sf9" sourceRef="p05_u1" targetRef="p05_a3" />
    <sequenceFlow id="p05_sf10" sourceRef="p05_a3" targetRef="p05_d3" />
    <sequenceFlow id="p05_sf11" sourceRef="p05_d3" targetRef="p05_a4" />
    <sequenceFlow id="p05_sf12" sourceRef="p05_a4" targetRef="p05_g3" />
    <sequenceFlow id="p05_sf13" name="Sí" sourceRef="p05_g3" targetRef="p05_g4" />
    <sequenceFlow id="p05_sf14" name="No" sourceRef="p05_g3" targetRef="p05_a5" />
    <sequenceFlow id="p05_sf15" sourceRef="p05_a5" targetRef="p05_e1" />
    <sequenceFlow id="p05_sf16" name="No" sourceRef="p05_g4" targetRef="p05_a6" />
    <sequenceFlow id="p05_sf17" name="Sí" sourceRef="p05_g4" targetRef="p05_a8" />
    <sequenceFlow id="p05_sf18" sourceRef="p05_a8" targetRef="p05_e3" />
    <sequenceFlow id="p05_sf19" sourceRef="p05_a6" targetRef="p05_d4" />
    <sequenceFlow id="p05_sf20" sourceRef="p05_d4" targetRef="p05_a7" />
    <sequenceFlow id="p05_sf21" sourceRef="p05_a7" targetRef="p05_e2" />
  </process>
  <process id="p05_pool2_proc" name="05b Cierre semanal automático (TO-BE - no implementado)" isExecutable="false">
      <documentation>TO-BE PROPUESTO (no implementado en Fase 3, commit af7d14d): no existe job de cierre semanal, tabla de semana, historial de insignias ni cálculo de racha. Fuente: ausencia en 01_schema.sql, rutas_db.py y main.py.</documentation>
    <laneSet id="p05_pool2_ls">
      <lane id="p05_pool2_lane_1" name="Planificador (cron)">
        <flowNodeRef>p05_c0</flowNodeRef>
      </lane>
      <lane id="p05_pool2_lane_2" name="Servicio de desafíos">
        <flowNodeRef>p05_c1</flowNodeRef>
        <flowNodeRef>p05_c2</flowNodeRef>
        <flowNodeRef>p05_c3</flowNodeRef>
        <flowNodeRef>p05_c4</flowNodeRef>
        <flowNodeRef>p05_cg</flowNodeRef>
        <flowNodeRef>p05_c5</flowNodeRef>
        <flowNodeRef>p05_c6</flowNodeRef>
        <flowNodeRef>p05_cj</flowNodeRef>
        <flowNodeRef>p05_c7</flowNodeRef>
        <flowNodeRef>p05_ce</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p05_c0" name="Domingo 23:59 (hora de Chile)"><timerEventDefinition /></startEvent>
    <serviceTask id="p05_c1" name="Cerrar el desafío de la semana" />
    <serviceTask id="p05_c2" name="Calcular participaciones completadas y racha" />
    <serviceTask id="p05_c3" name="Archivar progreso e insignias" />
    <serviceTask id="p05_c4" name="Crear el desafío de la nueva semana" />
    <exclusiveGateway id="p05_cg" name="¿Hay hábitos nuevos configurados?" />
    <serviceTask id="p05_c5" name="Reutilizar los hábitos de la semana anterior" />
    <serviceTask id="p05_c6" name="Asignar los hábitos configurados" />
    <exclusiveGateway id="p05_cj" />
    <serviceTask id="p05_c7" name="Reiniciar el progreso a 0 %" />
    <endEvent id="p05_ce" name="Fin: nueva semana lista" />
    <sequenceFlow id="p05_sf22" sourceRef="p05_c0" targetRef="p05_c1" />
    <sequenceFlow id="p05_sf23" sourceRef="p05_c1" targetRef="p05_c2" />
