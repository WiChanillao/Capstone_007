# Copiar a .env. Nunca subir el .env real al repositorio.
# IMPORTANTE: antes de levantar con Docker, edita .env y define una clave propia
# en MYSQL_ROOT_PASSWORD (y MYSQL_PASSWORD). Los valores de ejemplo NO son seguros.
# ===== MySQL =====
# MYSQL_HOST / MYSQL_PORT: solo para correr SIN Docker (MySQL local en 3306).
# Dentro del compose el backend usa MYSQL_HOST=mysql y MYSQL_PORT=3306.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=cambiar_esta_clave
MYSQL_DB=ecoscan
MYSQL_ROOT_PASSWORD=cambiar_esta_clave
# Solo para Docker: puerto publicado del MySQL en la máquina anfitriona.
MYSQL_HOST_PORT=3307

# ===== Backend =====
# Orígenes CORS/CSP permitidos (separados por coma). Sin comodín.
# Si se comparte por túnel, añadir aquí la URL pública, p. ej. https://xxx.trycloudflare.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
LIMITE_PREDICT_MINUTO=30
# Red desde la que se aceptan X-Real-IP / X-Forwarded-For (nginx). Fuera de ella se ignoran.
RED_PROXY_CONFIABLE=172.18.0.0/16
UMBRAL_CONFIANZA=0.5
# Umbral de decisión por clase. Defaults 0,5: no cambia el comportamiento
# hasta que se ajusten. Evaluados en test: Aluminio 0,25 / Cartón 0,45 /
# Plástico 0,20. NO aplicados por defecto.
UMBRAL_ALUMINIO=0.5
UMBRAL_CARTON=0.5
UMBRAL_PLASTICO=0.5
# Detecciones entre UMBRAL_POSIBLE y el umbral de su clase se devuelven en
# detecciones_posibles con aviso "Posible <material> (confianza baja)".
UMBRAL_POSIBLE=0.2
# Nitidez mínima (varianza del Laplaciano sobre 640 px) SOLO cuando el modelo no
# devuelve detecciones. Con detecciones siempre se responde 200 y se añade el
# aviso "baja_nitidez" si se está por debajo de este valor. Referencia
# orientativa, no validada con el split de test (FASE 3 pendiente).
UMBRAL_NITIDEZ=50
DATASET_VERSION=ecoscan-3clases-v1
DIRECTORIO_BACKUPS=backups

# ===== Frontend =====
VITE_API_URL=/api
