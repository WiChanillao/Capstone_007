# Copiar a .env y ajustar. NUNCA subir el .env real al repositorio.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=cambiar_por_clave_segura
MYSQL_DB=ecoscan

# Orígenes permitidos por CORS (separados por coma). En producción usar el dominio HTTPS exacto.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Límite de predicciones por IP y minuto (REC-106)
LIMITE_PREDICT_MINUTO=30

# Umbrales del escáner (REC-103 / REC-104)
UMBRAL_CONFIANZA=0.5
# Umbral de decisión por clase (default 0,5 = sin cambio de comportamiento).
UMBRAL_ALUMINIO=0.5
UMBRAL_CARTON=0.5
UMBRAL_PLASTICO=0.5
# Nivel "posible": entre este valor y el umbral de la clase, aviso de baja confianza.
UMBRAL_POSIBLE=0.2
# Alinear con el default real del backend y de docker-compose (era 100).
UMBRAL_NITIDEZ=50

# Versión del dataset expuesta en /version (REC-116)
DATASET_VERSION=ecoscan-3clases-v1

# Respaldos (REC-118)
DIRECTORIO_BACKUPS=backups
