    <sequenceFlow id="p10_sf6" name="No" sourceRef="p10_g1" targetRef="p10_a4" />
    <sequenceFlow id="p10_sf7" sourceRef="p10_a3" targetRef="p10_g2" />
    <sequenceFlow id="p10_sf8" sourceRef="p10_a4" targetRef="p10_g2" />
    <sequenceFlow id="p10_sf9" sourceRef="p10_g2" targetRef="p10_a5" />
    <sequenceFlow id="p10_sf10" sourceRef="p10_a5" targetRef="p10_u2" />
    <sequenceFlow id="p10_sf11" sourceRef="p10_u2" targetRef="p10_g3" />
    <sequenceFlow id="p10_sf12" name="No" sourceRef="p10_g3" targetRef="p10_e1" />
    <sequenceFlow id="p10_sf13" name="Sí" sourceRef="p10_g3" targetRef="p10_u3" />
    <sequenceFlow id="p10_sf14" sourceRef="p10_u3" targetRef="p10_c1" />
    <sequenceFlow id="p10_sf15" sourceRef="p10_c1" targetRef="p10_g4" />
    <sequenceFlow id="p10_sf16" name="Corregir datos" sourceRef="p10_g4" targetRef="p10_u3" />
    <sequenceFlow id="p10_sf17" name="Sí" sourceRef="p10_g4" targetRef="p10_c2" />
    <sequenceFlow id="p10_sf18" sourceRef="p10_c2" targetRef="p10_m1" />
    <sequenceFlow id="p10_sf19" sourceRef="p10_m1" targetRef="p10_u4" />
    <sequenceFlow id="p10_sf20" name="Enlace abierto" sourceRef="p10_u4" targetRef="p10_c3" />
    <sequenceFlow id="p10_sf21" name="Sin respuesta" sourceRef="p10_bt" targetRef="p10_c6" />
    <sequenceFlow id="p10_sf22" sourceRef="p10_c6" targetRef="p10_e3" />
    <sequenceFlow id="p10_sf23" sourceRef="p10_c3" targetRef="p10_c4" />
    <sequenceFlow id="p10_sf24" sourceRef="p10_c4" targetRef="p10_c5" />
    <sequenceFlow id="p10_sf25" sourceRef="p10_c5" targetRef="p10_e2" />
  </process>
  <process id="p11_pool1_proc" name="11 Feedback de clasificación y mejora continua" isExecutable="false">
    <documentation>TO-BE (propuesto) - Permite al usuario corregir una clasificación y alimenta el reentrenamiento con muestras confirmadas y con consentimiento.</documentation>
    <laneSet id="p11_pool1_ls">
      <lane id="p11_pool1_lane_1" name="Usuario">
        <flowNodeRef>p11_s</flowNodeRef>
        <flowNodeRef>p11_g1</flowNodeRef>
        <flowNodeRef>p11_u1</flowNodeRef>
        <flowNodeRef>p11_u2</flowNodeRef>
        <flowNodeRef>p11_u3</flowNodeRef>
      </lane>
      <lane id="p11_pool1_lane_2" name="App EcoScan Chile">
        <flowNodeRef>p11_a1</flowNodeRef>
        <flowNodeRef>p11_e1</flowNodeRef>
        <flowNodeRef>p11_a2</flowNodeRef>
        <flowNodeRef>p11_g2</flowNodeRef>
        <flowNodeRef>p11_e2</flowNodeRef>
      </lane>
      <lane id="p11_pool1_lane_3" name="Servicio y base de datos">
        <flowNodeRef>p11_d1</flowNodeRef>
        <flowNodeRef>p11_g3</flowNodeRef>
        <flowNodeRef>p11_e3</flowNodeRef>
        <flowNodeRef>p11_d2</flowNodeRef>
        <flowNodeRef>p11_g5</flowNodeRef>
        <flowNodeRef>p11_t1</flowNodeRef>
        <flowNodeRef>p11_e5</flowNodeRef>
        <flowNodeRef>p11_e6</flowNodeRef>
      </lane>
      <lane id="p11_pool1_lane_4" name="Curador de datos">
        <flowNodeRef>p11_c1</flowNodeRef>
        <flowNodeRef>p11_g4</flowNodeRef>
        <flowNodeRef>p11_e4</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p11_s" name="Usuario ve el resultado de la clasificación" />
    <exclusiveGateway id="p11_g1" name="¿La clasificación es correcta?" />
    <userTask id="p11_u1" name="Presionar 'Correcta'" />
    <serviceTask id="p11_a1" name="Registrar feedback positivo" />
    <endEvent id="p11_e1" name="Fin: feedback registrado" />
    <userTask id="p11_u2" name="Presionar 'Incorrecta' y elegir el material correcto" />
    <userTask id="p11_u3" name="Escribir comentario (opcional)" />
    <serviceTask id="p11_a2" name="Validar feedback (inferencia existente, un voto por sesión)" />
    <exclusiveGateway id="p11_g2" name="¿Feedback válido?" />
    <endEvent id="p11_e2" name="Fin: feedback descartado" />
    <serviceTask id="p11_d1" name="Guardar feedback (correcto = No, material sugerido)"><documentation>INSERT feedback_inferencia</documentation></serviceTask>
    <exclusiveGateway id="p11_g3" name="¿Hay consentimiento e imagen almacenada?" />
    <endEvent id="p11_e3" name="Fin: se usa solo como métrica" />
    <userTask id="p11_c1" name="Revisar la imagen y confirmar la etiqueta correcta" />
    <exclusiveGateway id="p11_g4" name="¿Etiqueta confirmada?" />
    <endEvent id="p11_e4" name="Fin: muestra descartada" />
    <serviceTask id="p11_d2" name="Agregar a dataset candidato (pendiente de versión)"><documentation>INSERT imagen_dataset (split pendiente)</documentation></serviceTask>
    <exclusiveGateway id="p11_g5" name="¿Muestras candidatas ≥ umbral (p. ej. 200)?" />
    <intermediateThrowEvent id="p11_t1" name="Iniciar reentrenamiento (modelo 06)"><messageEventDefinition /></intermediateThrowEvent>
    <endEvent id="p11_e5" name="Fin: reentrenamiento solicitado" />
    <endEvent id="p11_e6" name="Fin: muestra en espera" />
    <sequenceFlow id="p11_sf1" sourceRef="p11_s" targetRef="p11_g1" />
    <sequenceFlow id="p11_sf2" name="Sí" sourceRef="p11_g1" targetRef="p11_u1" />
    <sequenceFlow id="p11_sf3" sourceRef="p11_u1" targetRef="p11_a1" />
    <sequenceFlow id="p11_sf4" sourceRef="p11_a1" targetRef="p11_e1" />
    <sequenceFlow id="p11_sf5" name="No" sourceRef="p11_g1" targetRef="p11_u2" />
    <sequenceFlow id="p11_sf6" sourceRef="p11_u2" targetRef="p11_u3" />
    <sequenceFlow id="p11_sf7" sourceRef="p11_u3" targetRef="p11_a2" />
    <sequenceFlow id="p11_sf8" sourceRef="p11_a2" targetRef="p11_g2" />
    <sequenceFlow id="p11_sf9" name="No" sourceRef="p11_g2" targetRef="p11_e2" />
    <sequenceFlow id="p11_sf10" name="Sí" sourceRef="p11_g2" targetRef="p11_d1" />
    <sequenceFlow id="p11_sf11" sourceRef="p11_d1" targetRef="p11_g3" />
    <sequenceFlow id="p11_sf12" name="No" sourceRef="p11_g3" targetRef="p11_e3" />
    <sequenceFlow id="p11_sf13" name="Sí" sourceRef="p11_g3" targetRef="p11_c1" />
    <sequenceFlow id="p11_sf14" sourceRef="p11_c1" targetRef="p11_g4" />
    <sequenceFlow id="p11_sf15" name="No" sourceRef="p11_g4" targetRef="p11_e4" />
    <sequenceFlow id="p11_sf16" name="Sí" sourceRef="p11_g4" targetRef="p11_d2" />
    <sequenceFlow id="p11_sf17" sourceRef="p11_d2" targetRef="p11_g5" />
    <sequenceFlow id="p11_sf18" name="Sí" sourceRef="p11_g5" targetRef="p11_t1" />
    <sequenceFlow id="p11_sf19" sourceRef="p11_t1" targetRef="p11_e5" />
    <sequenceFlow id="p11_sf20" name="No" sourceRef="p11_g5" targetRef="p11_e6" />
  </process>
  <process id="p12_pool1_proc" name="12 Reporte mensual de trazabilidad" isExecutable="false">
    <documentation>TO-BE (propuesto, a confirmar) - Genera evidencia estadística mensual a partir de las inferencias registradas (RNF-12). No calcula metas de la Ley REP: solo aporta datos de uso.</documentation>
    <laneSet id="p12_pool1_ls">
      <lane id="p12_pool1_lane_1" name="Planificador">
        <flowNodeRef>p12_s</flowNodeRef>
      </lane>
      <lane id="p12_pool1_lane_2" name="Servicio de reportes">
        <flowNodeRef>p12_r1</flowNodeRef>
        <flowNodeRef>p12_ga</flowNodeRef>
        <flowNodeRef>p12_r2</flowNodeRef>
        <flowNodeRef>p12_r3</flowNodeRef>
        <flowNodeRef>p12_r4</flowNodeRef>
        <flowNodeRef>p12_gj</flowNodeRef>
        <flowNodeRef>p12_r5</flowNodeRef>
        <flowNodeRef>p12_r6</flowNodeRef>
      </lane>
      <lane id="p12_pool1_lane_3" name="Base de datos">
        <flowNodeRef>p12_d1</flowNodeRef>
        <flowNodeRef>p12_d2</flowNodeRef>
        <flowNodeRef>p12_d3</flowNodeRef>
      </lane>
      <lane id="p12_pool1_lane_4" name="Responsable del proyecto">
        <flowNodeRef>p12_h1</flowNodeRef>
        <flowNodeRef>p12_g1</flowNodeRef>
        <flowNodeRef>p12_e</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p12_s" name="Primer día hábil de cada mes"><timerEventDefinition /></startEvent>
    <serviceTask id="p12_r1" name="Definir periodo del reporte (mes anterior)" />
    <serviceTask id="p12_d1" name="Extraer inferencias válidas del periodo"><documentation>SELECT inferencia WHERE resultado=OK AND fecha_hora en periodo</documentation></serviceTask>
    <parallelGateway id="p12_ga" />
    <serviceTask id="p12_r2" name="Contar inferencias por material y contenedor" />
    <serviceTask id="p12_r3" name="Contar inferencias por comuna de la sesión (si existe)" />
    <serviceTask id="p12_r4" name="Calcular tasa de rechazos (borrosa / confianza baja)" />
    <parallelGateway id="p12_gj" />
    <serviceTask id="p12_r5" name="Generar reporte (CSV y resumen PDF)" />
    <userTask id="p12_h1" name="Revisar consistencia del reporte" />
    <exclusiveGateway id="p12_g1" name="¿Reporte conforme?" />
    <serviceTask id="p12_r6" name="Corregir parámetros y regenerar" />
    <serviceTask id="p12_d2" name="Archivar reporte con hash de integridad" />
    <serviceTask id="p12_d3" name="Aplicar retención: anonimizar o eliminar datos &gt; 12 meses" />
    <endEvent id="p12_e" name="Fin: reporte mensual disponible" />
    <sequenceFlow id="p12_sf1" sourceRef="p12_s" targetRef="p12_r1" />
    <sequenceFlow id="p12_sf2" sourceRef="p12_r1" targetRef="p12_d1" />
    <sequenceFlow id="p12_sf3" sourceRef="p12_d1" targetRef="p12_ga" />
    <sequenceFlow id="p12_sf4" sourceRef="p12_ga" targetRef="p12_r2" />
    <sequenceFlow id="p12_sf5" sourceRef="p12_ga" targetRef="p12_r3" />
    <sequenceFlow id="p12_sf6" sourceRef="p12_ga" targetRef="p12_r4" />
    <sequenceFlow id="p12_sf7" sourceRef="p12_r2" targetRef="p12_gj" />
    <sequenceFlow id="p12_sf8" sourceRef="p12_r3" targetRef="p12_gj" />
    <sequenceFlow id="p12_sf9" sourceRef="p12_r4" targetRef="p12_gj" />
    <sequenceFlow id="p12_sf10" sourceRef="p12_gj" targetRef="p12_r5" />
    <sequenceFlow id="p12_sf11" sourceRef="p12_r5" targetRef="p12_h1" />
    <sequenceFlow id="p12_sf12" sourceRef="p12_h1" targetRef="p12_g1" />
    <sequenceFlow id="p12_sf13" name="No" sourceRef="p12_g1" targetRef="p12_r6" />
    <sequenceFlow id="p12_sf14" name="Regenerar" sourceRef="p12_r6" targetRef="p12_r5" />
    <sequenceFlow id="p12_sf15" name="Sí" sourceRef="p12_g1" targetRef="p12_d2" />
    <sequenceFlow id="p12_sf16" sourceRef="p12_d2" targetRef="p12_d3" />
    <sequenceFlow id="p12_sf17" sourceRef="p12_d3" targetRef="p12_e" />
  </process>
  <process id="p13_pool1_proc" name="13 Despliegue continuo y monitoreo de salud" isExecutable="false">
    <documentation>TO-BE (propuesto) - Pipeline CI/CD con pytest, build Docker, health check y rollback. Resuelve la brecha B-2 y apoya RNF-03, RNF-07, RNF-11.</documentation>
    <laneSet id="p13_pool1_ls">
      <lane id="p13_pool1_lane_1" name="Desarrollador">
        <flowNodeRef>p13_s</flowNodeRef>
        <flowNodeRef>p13_u1</flowNodeRef>
        <flowNodeRef>p13_u2</flowNodeRef>
        <flowNodeRef>p13_u3</flowNodeRef>
        <flowNodeRef>p13_u4</flowNodeRef>
      </lane>
      <lane id="p13_pool1_lane_2" name="Repositorio y CI">
        <flowNodeRef>p13_r1</flowNodeRef>
        <flowNodeRef>p13_ga</flowNodeRef>
        <flowNodeRef>p13_r2</flowNodeRef>
        <flowNodeRef>p13_r3</flowNodeRef>
        <flowNodeRef>p13_r4</flowNodeRef>
        <flowNodeRef>p13_gj</flowNodeRef>
        <flowNodeRef>p13_g1</flowNodeRef>
        <flowNodeRef>p13_r5</flowNodeRef>
        <flowNodeRef>p13_r6</flowNodeRef>
        <flowNodeRef>p13_g2</flowNodeRef>
        <flowNodeRef>p13_r7</flowNodeRef>
      </lane>
      <lane id="p13_pool1_lane_3" name="Entorno cloud (Docker)">
        <flowNodeRef>p13_k1</flowNodeRef>
        <flowNodeRef>p13_k2</flowNodeRef>
        <flowNodeRef>p13_g3</flowNodeRef>
        <flowNodeRef>p13_k3</flowNodeRef>
        <flowNodeRef>p13_e1</flowNodeRef>
        <flowNodeRef>p13_k4</flowNodeRef>
        <flowNodeRef>p13_t1</flowNodeRef>
        <flowNodeRef>p13_g4</flowNodeRef>
        <flowNodeRef>p13_k5</flowNodeRef>
        <flowNodeRef>p13_e2</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p13_s" name="Cambio listo en rama de trabajo" />
    <userTask id="p13_u1" name="Abrir pull request hacia main" />
    <serviceTask id="p13_r1" name="Disparar pipeline de CI" />
    <parallelGateway id="p13_ga" />
    <serviceTask id="p13_r2" name="Lint y pruebas unitarias del backend (pytest)" />
    <serviceTask id="p13_r3" name="Pruebas de integración de /predict (httpx)" />
    <serviceTask id="p13_r4" name="Build y pruebas del frontend (Vite)" />
    <parallelGateway id="p13_gj" />
    <exclusiveGateway id="p13_g1" name="¿Todo en verde?" />
    <userTask id="p13_u2" name="Corregir y subir nuevos commits" />
    <userTask id="p13_u3" name="Revisión de código y aprobación del PR" />
    <serviceTask id="p13_r5" name="Merge a main" />
    <serviceTask id="p13_r6" name="Construir imagen Docker y escanear vulnerabilidades" />
    <exclusiveGateway id="p13_g2" name="¿Sin vulnerabilidades críticas?" />
    <serviceTask id="p13_r7" name="Publicar imagen versionada en el registro" />
    <serviceTask id="p13_k1" name="Desplegar en staging" />
    <serviceTask id="p13_k2" name="Smoke tests y GET /health" />
    <exclusiveGateway id="p13_g3" name="¿Salud OK?" />
    <serviceTask id="p13_k3" name="Rollback a la versión anterior" />
    <endEvent id="p13_e1" name="Fin: despliegue fallido"><errorEventDefinition /></endEvent>
    <userTask id="p13_u4" name="Aprobar paso a producción" />
    <serviceTask id="p13_k4" name="Desplegar en producción (CORS con dominio final)" />
    <intermediateCatchEvent id="p13_t1" name="Health check cada 1 min"><timerEventDefinition /></intermediateCatchEvent>
    <exclusiveGateway id="p13_g4" name="¿Responde /health?" />
    <serviceTask id="p13_k5" name="Alertar al equipo y ejecutar rollback" />
    <endEvent id="p13_e2" name="Fin: servicio revertido" />
    <sequenceFlow id="p13_sf1" sourceRef="p13_s" targetRef="p13_u1" />
    <sequenceFlow id="p13_sf2" sourceRef="p13_u1" targetRef="p13_r1" />
    <sequenceFlow id="p13_sf3" sourceRef="p13_r1" targetRef="p13_ga" />
    <sequenceFlow id="p13_sf4" sourceRef="p13_ga" targetRef="p13_r2" />
    <sequenceFlow id="p13_sf5" sourceRef="p13_ga" targetRef="p13_r3" />
    <sequenceFlow id="p13_sf6" sourceRef="p13_ga" targetRef="p13_r4" />
    <sequenceFlow id="p13_sf7" sourceRef="p13_r2" targetRef="p13_gj" />
    <sequenceFlow id="p13_sf8" sourceRef="p13_r3" targetRef="p13_gj" />
    <sequenceFlow id="p13_sf9" sourceRef="p13_r4" targetRef="p13_gj" />
    <sequenceFlow id="p13_sf10" sourceRef="p13_gj" targetRef="p13_g1" />
    <sequenceFlow id="p13_sf11" name="No" sourceRef="p13_g1" targetRef="p13_u2" />
    <sequenceFlow id="p13_sf12" name="Nuevo commit" sourceRef="p13_u2" targetRef="p13_r1" />
    <sequenceFlow id="p13_sf13" name="Sí" sourceRef="p13_g1" targetRef="p13_u3" />
    <sequenceFlow id="p13_sf14" sourceRef="p13_u3" targetRef="p13_r5" />
    <sequenceFlow id="p13_sf15" sourceRef="p13_r5" targetRef="p13_r6" />
    <sequenceFlow id="p13_sf16" sourceRef="p13_r6" targetRef="p13_g2" />
    <sequenceFlow id="p13_sf17" name="Vulnerable: corregir" sourceRef="p13_g2" targetRef="p13_u2" />
    <sequenceFlow id="p13_sf18" name="Sí" sourceRef="p13_g2" targetRef="p13_r7" />
    <sequenceFlow id="p13_sf19" sourceRef="p13_r7" targetRef="p13_k1" />
    <sequenceFlow id="p13_sf20" sourceRef="p13_k1" targetRef="p13_k2" />
    <sequenceFlow id="p13_sf21" sourceRef="p13_k2" targetRef="p13_g3" />
    <sequenceFlow id="p13_sf22" name="No" sourceRef="p13_g3" targetRef="p13_k3" />
    <sequenceFlow id="p13_sf23" sourceRef="p13_k3" targetRef="p13_e1" />
    <sequenceFlow id="p13_sf24" name="Sí" sourceRef="p13_g3" targetRef="p13_u4" />
    <sequenceFlow id="p13_sf25" sourceRef="p13_u4" targetRef="p13_k4" />
    <sequenceFlow id="p13_sf26" sourceRef="p13_k4" targetRef="p13_t1" />
