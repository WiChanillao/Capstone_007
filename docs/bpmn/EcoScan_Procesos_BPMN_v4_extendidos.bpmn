  <process id="p09_pool1_proc" name="09 Verificación periódica de enlaces externos" isExecutable="false">
    <documentation>TO-BE (propuesto) - Detecta enlaces caídos (brecha B-5, RNF-10, caso CP-06) y los oculta hasta su reemplazo.</documentation>
    <laneSet id="p09_pool1_ls">
      <lane id="p09_pool1_lane_1" name="Planificador (cron)">
        <flowNodeRef>p09_s</flowNodeRef>
      </lane>
      <lane id="p09_pool1_lane_2" name="Servicio de verificación">
        <flowNodeRef>p09_v1</flowNodeRef>
        <flowNodeRef>p09_v2</flowNodeRef>
        <flowNodeRef>p09_v3</flowNodeRef>
        <flowNodeRef>p09_g1</flowNodeRef>
        <flowNodeRef>p09_v4</flowNodeRef>
        <flowNodeRef>p09_v5</flowNodeRef>
        <flowNodeRef>p09_g2</flowNodeRef>
        <flowNodeRef>p09_v6</flowNodeRef>
        <flowNodeRef>p09_v7</flowNodeRef>
        <flowNodeRef>p09_g4</flowNodeRef>
        <flowNodeRef>p09_v8</flowNodeRef>
        <flowNodeRef>p09_e</flowNodeRef>
      </lane>
      <lane id="p09_pool1_lane_3" name="Sitio del recurso externo">
        <flowNodeRef>p09_w1</flowNodeRef>
      </lane>
      <lane id="p09_pool1_lane_4" name="Equipo EcoScan">
        <flowNodeRef>p09_t1</flowNodeRef>
        <flowNodeRef>p09_t2</flowNodeRef>
        <flowNodeRef>p09_g3</flowNodeRef>
        <flowNodeRef>p09_t3</flowNodeRef>
        <flowNodeRef>p09_t4</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p09_s" name="Cada semana (domingo 03:00)"><timerEventDefinition /></startEvent>
    <serviceTask id="p09_v1" name="Obtener los recursos externos activos"><documentation>SELECT recurso_externo WHERE activo</documentation></serviceTask>
    <serviceTask id="p09_v2" name="Tomar el siguiente recurso de la lista" />
    <serviceTask id="p09_v3" name="Enviar solicitud HTTP con timeout de 8 s" />
    <serviceTask id="p09_w1" name="Responder con código HTTP" />
    <exclusiveGateway id="p09_g1" name="¿Código 2xx o 3xx?" />
    <serviceTask id="p09_v4" name="Registrar verificación OK (código, latencia)"><documentation>INSERT verificacion_enlace</documentation></serviceTask>
    <serviceTask id="p09_v5" name="Reintentar hasta 2 veces con espera" />
    <exclusiveGateway id="p09_g2" name="¿Responde tras los reintentos?" />
    <serviceTask id="p09_v6" name="Registrar enlace caído y marcar recurso no disponible"><documentation>UPDATE recurso_externo SET estado_enlace</documentation></serviceTask>
    <serviceTask id="p09_v7" name="Ocultar el enlace en la interfaz hasta su recuperación" />
    <serviceTask id="p09_t1" name="Crear ticket y notificar al equipo (Jira / correo)" />
    <userTask id="p09_t2" name="Revisar el sitio y buscar un enlace alternativo" />
    <exclusiveGateway id="p09_g3" name="¿Hay enlace alternativo?" />
    <userTask id="p09_t3" name="Actualizar el recurso en el catálogo" />
    <userTask id="p09_t4" name="Mantener oculto y reintentar en el próximo ciclo" />
    <exclusiveGateway id="p09_g4" name="¿Quedan recursos por verificar?" />
    <serviceTask id="p09_v8" name="Generar resumen de la verificación (OK / caídos)" />
    <endEvent id="p09_e" name="Fin: verificación completada" />
