  <process id="p05_pool2_proc" name="05b Cierre semanal automático (propuesto)" isExecutable="false">
    <laneSet id="p05_pool2_ls">
      <lane id="p05_pool2_lane_1" name="Planificador (cron)">
        <flowNodeRef>p05_c0</flowNodeRef>
      </lane>
