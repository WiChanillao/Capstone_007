        <flowNodeRef>p10_g2</flowNodeRef>
        <flowNodeRef>p10_a5</flowNodeRef>
      </lane>
      <lane id="p10_pool1_lane_3" name="Servicio de cuentas">
        <flowNodeRef>p10_c1</flowNodeRef>
        <flowNodeRef>p10_g4</flowNodeRef>
        <flowNodeRef>p10_c2</flowNodeRef>
        <flowNodeRef>p10_c6</flowNodeRef>
        <flowNodeRef>p10_e3</flowNodeRef>
        <flowNodeRef>p10_c3</flowNodeRef>
        <flowNodeRef>p10_c4</flowNodeRef>
        <flowNodeRef>p10_c5</flowNodeRef>
        <flowNodeRef>p10_e2</flowNodeRef>
      </lane>
      <lane id="p10_pool1_lane_4" name="Servicio de correo">
        <flowNodeRef>p10_m1</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p10_s" name="Primera visita a EcoScan Chile" />
    <serviceTask id="p10_a1" name="Crear sesión anónima (UUID) y guardarla en el navegador"><documentation>INSERT sesion</documentation></serviceTask>
    <serviceTask id="p10_a2" name="Mostrar aviso de privacidad y uso de datos" />
    <userTask id="p10_u1" name="Decidir si permite guardar imágenes para mejorar el modelo" />
    <exclusiveGateway id="p10_g1" name="¿Acepta guardar imágenes?" />
    <serviceTask id="p10_a3" name="Registrar consentimiento = Sí"><documentation>UPDATE sesion SET consentimiento_imagenes</documentation></serviceTask>
    <serviceTask id="p10_a4" name="Registrar consentimiento = No (solo hash de la imagen)" />
    <exclusiveGateway id="p10_g2" />
    <serviceTask id="p10_a5" name="Habilitar uso sin cuenta de los 4 módulos (RF-24)" />
    <userTask id="p10_u2" name="Usar escáner, puntos limpios, simulador y desafío" />
    <exclusiveGateway id="p10_g3" name="¿Desea crear cuenta para guardar su progreso?" />
    <endEvent id="p10_e1" name="Fin: sigue como anónimo" />
    <userTask id="p10_u3" name="Completar registro (correo, nombre, comuna)" />
    <serviceTask id="p10_c1" name="Validar datos y unicidad del correo" />
    <exclusiveGateway id="p10_g4" name="¿Datos válidos?" />
    <serviceTask id="p10_c2" name="Crear usuario (rol usuario) y token de verificación"><documentation>INSERT usuario</documentation></serviceTask>
    <serviceTask id="p10_m1" name="Enviar correo con enlace de verificación" />
    <userTask id="p10_u4" name="Abrir el enlace de verificación" />
    <boundaryEvent id="p10_bt" name="Expira en 24 h" attachedToRef="p10_u4" cancelActivity="true"><timerEventDefinition /></boundaryEvent>
    <serviceTask id="p10_c6" name="Invalidar enlace y ofrecer reenvío" />
    <endEvent id="p10_e3" name="Fin: verificación expirada" />
    <serviceTask id="p10_c3" name="Marcar la cuenta como verificada" />
    <serviceTask id="p10_c4" name="Vincular la sesión anónima con el usuario"><documentation>UPDATE sesion SET id_usuario</documentation></serviceTask>
    <serviceTask id="p10_c5" name="Migrar progreso del desafío y escenarios guardados" />
    <endEvent id="p10_e2" name="Fin: cuenta activa con progreso conservado" />
    <sequenceFlow id="p10_sf1" sourceRef="p10_s" targetRef="p10_a1" />
    <sequenceFlow id="p10_sf2" sourceRef="p10_a1" targetRef="p10_a2" />
    <sequenceFlow id="p10_sf3" sourceRef="p10_a2" targetRef="p10_u1" />
    <sequenceFlow id="p10_sf4" sourceRef="p10_u1" targetRef="p10_g1" />
