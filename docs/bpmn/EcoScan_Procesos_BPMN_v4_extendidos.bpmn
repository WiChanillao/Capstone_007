  <process id="p10_pool1_proc" name="10 Sesión anónima, consentimiento y cuenta opcional" isExecutable="false">
    <documentation>TO-BE (propuesto) - Mantiene RF-24 (uso sin cuenta) y habilita guardar progreso y escenarios mediante una cuenta opcional con consentimiento explícito.</documentation>
    <laneSet id="p10_pool1_ls">
      <lane id="p10_pool1_lane_1" name="Visitante / Usuario">
