  <process id="p08_pool1_proc" name="08 Curaduría y actualización de puntos limpios" isExecutable="false">
    <documentation>TO-BE (propuesto) - Mantener vigentes los datos de puntos limpios (RF-12) con fuentes oficiales, validación, aprobación y atención de reportes de usuarios.</documentation>
