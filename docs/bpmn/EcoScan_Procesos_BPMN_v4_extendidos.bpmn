  <process id="p04_pool1_proc" name="04 Eco-Simulador RM: calcular el aporte ecológico semanal" isExecutable="false">
    <documentation>AS-IS con extensiones propuestas - Cálculo reactivo del impacto anual (agua, CO₂, residuos), equivalencias y mensaje educativo; opcionalmente guarda el escenario. Cubre RF-15 a RF-18.</documentation>
    <laneSet id="p04_pool1_ls">
      <lane id="p04_pool1_lane_1" name="Usuario">
        <flowNodeRef>p04_s</flowNodeRef>
        <flowNodeRef>p04_u1</flowNodeRef>
        <flowNodeRef>p04_g1</flowNodeRef>
        <flowNodeRef>p04_g2</flowNodeRef>
        <flowNodeRef>p04_e1</flowNodeRef>
      </lane>
      <lane id="p04_pool1_lane_2" name="App EcoScan Chile">
        <flowNodeRef>p04_a1</flowNodeRef>
        <flowNodeRef>p04_a2</flowNodeRef>
        <flowNodeRef>p04_a3</flowNodeRef>
        <flowNodeRef>p04_ga</flowNodeRef>
        <flowNodeRef>p04_a4</flowNodeRef>
        <flowNodeRef>p04_a5</flowNodeRef>
        <flowNodeRef>p04_a6</flowNodeRef>
        <flowNodeRef>p04_gj</flowNodeRef>
        <flowNodeRef>p04_a7</flowNodeRef>
        <flowNodeRef>p04_a8</flowNodeRef>
        <flowNodeRef>p04_a9</flowNodeRef>
        <flowNodeRef>p04_a10</flowNodeRef>
      </lane>
      <lane id="p04_pool1_lane_3" name="Parámetros y factores de impacto">
        <flowNodeRef>p04_d1</flowNodeRef>
        <flowNodeRef>p04_d2</flowNodeRef>
        <flowNodeRef>p04_e2</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p04_s" name="Abrir 'Eco-Simulador RM'" />
    <serviceTask id="p04_a1" name="Solicitar ítems, rangos y valores por defecto" />
    <serviceTask id="p04_d1" name="Entregar ítems y factores de impacto vigentes"><documentation>SELECT item_simulador JOIN factor_impacto (vigente)</documentation></serviceTask>
    <serviceTask id="p04_a2" name="Mostrar 3 deslizadores con valores por defecto e impacto inicial" />
    <userTask id="p04_u1" name="Ajustar deslizador (botellas PET, latas o cajas de cartón)" />
    <serviceTask id="p04_a3" name="Validar rango (mín–máx) y número entero" />
    <parallelGateway id="p04_ga" />
    <serviceTask id="p04_a4" name="Calcular agua ahorrada anual (L)" />
    <serviceTask id="p04_a5" name="Calcular CO₂ no emitido anual (kg)" />
    <serviceTask id="p04_a6" name="Calcular residuos desviados anuales (kg)" />
    <parallelGateway id="p04_gj" />
    <serviceTask id="p04_a7" name="Calcular equivalencias (duchas de 5 min, km en bus Red)" />
    <serviceTask id="p04_a8" name="Seleccionar mensaje '¿Sabías que...?' según el impacto" />
    <serviceTask id="p04_a9" name="Actualizar tarjetas de impacto y mensaje en pantalla" />
    <exclusiveGateway id="p04_g1" name="¿Ajusta otro valor?" />
    <exclusiveGateway id="p04_g2" name="¿Desea guardar el escenario?" />
    <endEvent id="p04_e1" name="Fin: usuario revisa su impacto" />
    <serviceTask id="p04_a10" name="Guardar escenario (ítems, totales y fecha)" />
    <serviceTask id="p04_d2" name="Persistir escenario_simulacion y escenario_item"><documentation>INSERT escenario_simulacion, escenario_item</documentation></serviceTask>
    <endEvent id="p04_e2" name="Fin: escenario guardado" />
    <sequenceFlow id="p04_sf1" sourceRef="p04_s" targetRef="p04_a1" />
    <sequenceFlow id="p04_sf2" sourceRef="p04_a1" targetRef="p04_d1" />
    <sequenceFlow id="p04_sf3" sourceRef="p04_d1" targetRef="p04_a2" />
    <sequenceFlow id="p04_sf4" sourceRef="p04_a2" targetRef="p04_u1" />
    <sequenceFlow id="p04_sf5" sourceRef="p04_u1" targetRef="p04_a3" />
    <sequenceFlow id="p04_sf6" sourceRef="p04_a3" targetRef="p04_ga" />
    <sequenceFlow id="p04_sf7" sourceRef="p04_ga" targetRef="p04_a4" />
    <sequenceFlow id="p04_sf8" sourceRef="p04_ga" targetRef="p04_a5" />
    <sequenceFlow id="p04_sf9" sourceRef="p04_ga" targetRef="p04_a6" />
    <sequenceFlow id="p04_sf10" sourceRef="p04_a4" targetRef="p04_gj" />
    <sequenceFlow id="p04_sf11" sourceRef="p04_a5" targetRef="p04_gj" />
    <sequenceFlow id="p04_sf12" sourceRef="p04_a6" targetRef="p04_gj" />
    <sequenceFlow id="p04_sf13" sourceRef="p04_gj" targetRef="p04_a7" />
    <sequenceFlow id="p04_sf14" sourceRef="p04_a7" targetRef="p04_a8" />
    <sequenceFlow id="p04_sf15" sourceRef="p04_a8" targetRef="p04_a9" />
    <sequenceFlow id="p04_sf16" sourceRef="p04_a9" targetRef="p04_g1" />
    <sequenceFlow id="p04_sf17" name="Sí" sourceRef="p04_g1" targetRef="p04_u1" />
    <sequenceFlow id="p04_sf18" name="No" sourceRef="p04_g1" targetRef="p04_g2" />
    <sequenceFlow id="p04_sf19" name="Sí" sourceRef="p04_g2" targetRef="p04_a10" />
    <sequenceFlow id="p04_sf20" name="No" sourceRef="p04_g2" targetRef="p04_e1" />
    <sequenceFlow id="p04_sf21" sourceRef="p04_a10" targetRef="p04_d2" />
