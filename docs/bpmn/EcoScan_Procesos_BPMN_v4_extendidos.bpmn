  <process id="p06_pool1_proc" name="06 Ciclo de vida del modelo de clasificación (MLOps)" isExecutable="false">
    <documentation>TO-BE (propuesto) - Desde la definición de clases hasta el monitoreo y reentrenamiento del modelo YOLOv8n-cls, con las compuertas de calidad RNF-01 y RNF-02.</documentation>
    <laneSet id="p06_pool1_ls">
      <lane id="p06_pool1_lane_1" name="Equipo de datos">
        <flowNodeRef>p06_s</flowNodeRef>
        <flowNodeRef>p06_d1</flowNodeRef>
        <flowNodeRef>p06_d2</flowNodeRef>
        <flowNodeRef>p06_d3</flowNodeRef>
        <flowNodeRef>p06_d4</flowNodeRef>
      </lane>
      <lane id="p06_pool1_lane_2" name="Pipeline de entrenamiento (Ultralytics)">
        <flowNodeRef>p06_p1</flowNodeRef>
        <flowNodeRef>p06_p2</flowNodeRef>
        <flowNodeRef>p06_p3</flowNodeRef>
        <flowNodeRef>p06_g1</flowNodeRef>
        <flowNodeRef>p06_p4</flowNodeRef>
        <flowNodeRef>p06_p5</flowNodeRef>
        <flowNodeRef>p06_g2</flowNodeRef>
        <flowNodeRef>p06_p6</flowNodeRef>
      </lane>
      <lane id="p06_pool1_lane_3" name="Líder técnico (aprobador)">
        <flowNodeRef>p06_l1</flowNodeRef>
        <flowNodeRef>p06_g3</flowNodeRef>
        <flowNodeRef>p06_e1</flowNodeRef>
      </lane>
      <lane id="p06_pool1_lane_4" name="Entorno de producción">
        <flowNodeRef>p06_o1</flowNodeRef>
        <flowNodeRef>p06_o2</flowNodeRef>
        <flowNodeRef>p06_g4</flowNodeRef>
        <flowNodeRef>p06_o3</flowNodeRef>
        <flowNodeRef>p06_e2</flowNodeRef>
        <flowNodeRef>p06_o4</flowNodeRef>
        <flowNodeRef>p06_o5</flowNodeRef>
        <flowNodeRef>p06_t1</flowNodeRef>
        <flowNodeRef>p06_g5</flowNodeRef>
        <flowNodeRef>p06_x1</flowNodeRef>
        <flowNodeRef>p06_e3</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p06_s" name="Nueva versión del modelo requerida" />
    <userTask id="p06_d1" name="Definir clases de materiales y reglas de etiquetado" />
    <userTask id="p06_d2" name="Recolectar imágenes por clase (propias, públicas, feedback)" />
    <userTask id="p06_d3" name="Etiquetar y depurar (duplicados, baja calidad)" />
    <serviceTask id="p06_p1" name="Dividir en train / val / test y versionar el dataset"><documentation>INSERT dataset_version, imagen_dataset</documentation></serviceTask>
    <serviceTask id="p06_p2" name="Entrenar YOLOv8n-cls con hiperparámetros definidos" />
    <serviceTask id="p06_p3" name="Evaluar en validación: Macro-F1 y matriz de confusión"><documentation>INSERT evaluacion_modelo, evaluacion_clase</documentation></serviceTask>
    <exclusiveGateway id="p06_g1" name="¿Macro-F1 ≥ 0,85? (RNF-02)" />
    <userTask id="p06_d4" name="Analizar errores y clases débiles; ampliar datos" />
    <serviceTask id="p06_p4" name="Exportar pesos del modelo y registrar versión"><documentation>INSERT modelo_ml, clase_modelo</documentation></serviceTask>
    <serviceTask id="p06_p5" name="Medir latencia en lote de 20+ imágenes" />
    <exclusiveGateway id="p06_g2" name="¿p95 ≤ 2 s? (RNF-01)" />
    <userTask id="p06_p6" name="Optimizar (resolución, cuantización)" />
    <userTask id="p06_l1" name="Revisar informe de métricas y aprobar liberación" />
    <exclusiveGateway id="p06_g3" name="¿Aprobado?" />
    <endEvent id="p06_e1" name="Fin: modelo rechazado" />
    <serviceTask id="p06_o1" name="Desplegar contenedor Docker con el nuevo modelo" />
    <serviceTask id="p06_o2" name="Smoke test y health check (GET /health)" />
    <exclusiveGateway id="p06_g4" name="¿Salud OK?" />
    <serviceTask id="p06_o3" name="Revertir a la versión anterior (rollback)" />
    <endEvent id="p06_e2" name="Fin: despliegue revertido"><errorEventDefinition /></endEvent>
    <serviceTask id="p06_o4" name="Activar modelo y registrar umbral y métricas"><documentation>UPDATE modelo_ml SET activo; parametro_sistema umbral</documentation></serviceTask>
    <serviceTask id="p06_o5" name="Monitorear inferencias, confianza media y feedback" />
    <intermediateCatchEvent id="p06_t1" name="Revisión mensual"><timerEventDefinition /></intermediateCatchEvent>
    <exclusiveGateway id="p06_g5" name="¿Caída de precisión o deriva de datos?" />
    <intermediateThrowEvent id="p06_x1" name="Iniciar reentrenamiento"><messageEventDefinition /></intermediateThrowEvent>
    <endEvent id="p06_e3" name="Fin: modelo vigente" />
    <sequenceFlow id="p06_sf1" sourceRef="p06_s" targetRef="p06_d1" />
    <sequenceFlow id="p06_sf2" sourceRef="p06_d1" targetRef="p06_d2" />
    <sequenceFlow id="p06_sf3" sourceRef="p06_d2" targetRef="p06_d3" />
    <sequenceFlow id="p06_sf4" sourceRef="p06_d3" targetRef="p06_p1" />
    <sequenceFlow id="p06_sf5" sourceRef="p06_p1" targetRef="p06_p2" />
    <sequenceFlow id="p06_sf6" sourceRef="p06_p2" targetRef="p06_p3" />
    <sequenceFlow id="p06_sf7" sourceRef="p06_p3" targetRef="p06_g1" />
    <sequenceFlow id="p06_sf8" name="No" sourceRef="p06_g1" targetRef="p06_d4" />
    <sequenceFlow id="p06_sf9" name="Aumentar datos" sourceRef="p06_d4" targetRef="p06_d2" />
    <sequenceFlow id="p06_sf10" name="Sí" sourceRef="p06_g1" targetRef="p06_p4" />
    <sequenceFlow id="p06_sf11" sourceRef="p06_p4" targetRef="p06_p5" />
    <sequenceFlow id="p06_sf12" sourceRef="p06_p5" targetRef="p06_g2" />
    <sequenceFlow id="p06_sf13" name="No" sourceRef="p06_g2" targetRef="p06_p6" />
    <sequenceFlow id="p06_sf14" name="Reentrenar" sourceRef="p06_p6" targetRef="p06_p2" />
