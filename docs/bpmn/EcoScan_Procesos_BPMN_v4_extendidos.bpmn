<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://ecoscan.example/bpmn" id="Definitions_EcoScan" name="EcoScan Chile - Modelos de procesos v4 (extendidos)">
  <collaboration id="Collab_EcoScan">
    <participant id="p01_pool1" name="01 Escáner IA: escanear un residuo (cliente)" processRef="p01_pool1_proc" />
    <participant id="p01_pool2" name="02 Servicio de inferencia POST /predict (ver modelo 02)" />
    <participant id="p02_pool1" name="Cliente: App EcoScan Chile (ver modelo 01)" />
    <participant id="p02_pool2" name="02 Servicio de inferencia: POST /predict" processRef="p02_pool2_proc" />
    <participant id="p03_pool1" name="03 Puntos Limpios RM: buscar un punto de reciclaje" processRef="p03_pool1_proc" />
    <participant id="p04_pool1" name="04 Eco-Simulador RM: calcular el aporte ecológico semanal" processRef="p04_pool1_proc" />
    <participant id="p05_pool1" name="05 Desafío Verde RM: completar los hábitos de la semana" processRef="p05_pool1_proc" />
    <participant id="p05_pool2" name="05b Cierre semanal automático (propuesto)" processRef="p05_pool2_proc" />
    <participant id="p06_pool1" name="06 Ciclo de vida del modelo de clasificación (MLOps)" processRef="p06_pool1_proc" />
    <participant id="p07_pool1" name="07 Gestión del catálogo de materiales y contenedores" processRef="p07_pool1_proc" />
    <participant id="p08_pool1" name="08 Curaduría y actualización de puntos limpios" processRef="p08_pool1_proc" />
    <participant id="p09_pool1" name="09 Verificación periódica de enlaces externos" processRef="p09_pool1_proc" />
    <participant id="p10_pool1" name="10 Sesión anónima, consentimiento y cuenta opcional" processRef="p10_pool1_proc" />
    <participant id="p11_pool1" name="11 Feedback de clasificación y mejora continua" processRef="p11_pool1_proc" />
    <participant id="p12_pool1" name="12 Reporte mensual de trazabilidad" processRef="p12_pool1_proc" />
    <participant id="p13_pool1" name="13 Despliegue continuo y monitoreo de salud" processRef="p13_pool1_proc" />
    <participant id="p14_pool1" name="14 Gestión de incidentes del servicio" processRef="p14_pool1_proc" />
    <messageFlow id="p01_mf1" name="Imagen (multipart)" sourceRef="p01_a7" targetRef="p01_pool2" />
    <messageFlow id="p01_mf2" name="Respuesta JSON" sourceRef="p01_pool2" targetRef="p01_w1" />
    <messageFlow id="p02_mf1" name="Imagen (multipart)" sourceRef="p02_pool1" targetRef="p02_s" />
    <messageFlow id="p02_mf2" name="Respuesta JSON" sourceRef="p02_e8" targetRef="p02_pool1" />
  </collaboration>
  <process id="p01_pool1_proc" name="01 Escáner IA: escanear un residuo (cliente)" isExecutable="false">
    <documentation>AS-IS con extensiones propuestas - Recorrido completo del usuario en la pestaña Escáner IA: origen de la imagen, validación local, errores, resultados y repetición. Cubre RF-01 a RF-11, RF-23, RF-24.</documentation>
    <laneSet id="p01_pool1_ls">
      <lane id="p01_pool1_lane_1" name="Usuario">
        <flowNodeRef>p01_s</flowNodeRef>
        <flowNodeRef>p01_u1</flowNodeRef>
        <flowNodeRef>p01_g1</flowNodeRef>
        <flowNodeRef>p01_u3</flowNodeRef>
        <flowNodeRef>p01_u2</flowNodeRef>
        <flowNodeRef>p01_g3</flowNodeRef>
        <flowNodeRef>p01_u5</flowNodeRef>
        <flowNodeRef>p01_g6</flowNodeRef>
        <flowNodeRef>p01_u6</flowNodeRef>
        <flowNodeRef>p01_u7</flowNodeRef>
        <flowNodeRef>p01_e4</flowNodeRef>
      </lane>
      <lane id="p01_pool1_lane_2" name="App EcoScan Chile (React + Vite)">
        <flowNodeRef>p01_a1</flowNodeRef>
        <flowNodeRef>p01_ga</flowNodeRef>
        <flowNodeRef>p01_b1</flowNodeRef>
        <flowNodeRef>p01_b2</flowNodeRef>
        <flowNodeRef>p01_a2</flowNodeRef>
        <flowNodeRef>p01_g2</flowNodeRef>
        <flowNodeRef>p01_a3</flowNodeRef>
        <flowNodeRef>p01_e0</flowNodeRef>
        <flowNodeRef>p01_a4</flowNodeRef>
        <flowNodeRef>p01_g4</flowNodeRef>
        <flowNodeRef>p01_a5</flowNodeRef>
        <flowNodeRef>p01_e1</flowNodeRef>
        <flowNodeRef>p01_a6</flowNodeRef>
        <flowNodeRef>p01_a7</flowNodeRef>
        <flowNodeRef>p01_bt</flowNodeRef>
        <flowNodeRef>p01_w1</flowNodeRef>
        <flowNodeRef>p01_g5</flowNodeRef>
        <flowNodeRef>p01_a9</flowNodeRef>
        <flowNodeRef>p01_a10</flowNodeRef>
        <flowNodeRef>p01_a8</flowNodeRef>
        <flowNodeRef>p01_e2</flowNodeRef>
        <flowNodeRef>p01_e3</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p01_s" name="Usuario abre EcoScan Chile" />
    <serviceTask id="p01_a1" name="Cargar app y mostrar 4 pestañas (Escáner IA activa)" />
    <parallelGateway id="p01_ga" />
    <serviceTask id="p01_b1" name="Mostrar banner de impacto ambiental RM"><documentation>Tabla banner_impacto (RF-11)</documentation></serviceTask>
    <intermediateCatchEvent id="p01_b2" name="Rotación o clic en 'Siguiente'"><timerEventDefinition /></intermediateCatchEvent>
    <userTask id="p01_u1" name="Presionar 'Subir Imagen / Tomar Foto'" />
    <exclusiveGateway id="p01_g1" name="¿Origen de la imagen?" />
    <serviceTask id="p01_a2" name="Solicitar permiso de cámara al navegador" />
    <exclusiveGateway id="p01_g2" name="¿Permiso concedido?" />
    <serviceTask id="p01_a3" name="Informar: usar galería de archivos" />
    <endEvent id="p01_e0" name="Fin: sin cámara" />
    <userTask id="p01_u3" name="Tomar foto con la cámara" />
    <userTask id="p01_u2" name="Elegir imagen desde archivo" />
    <exclusiveGateway id="p01_g3" />
    <serviceTask id="p01_a4" name="Validar tipo (JPG/PNG/WebP) y tamaño en el cliente" />
    <exclusiveGateway id="p01_g4" name="¿Archivo válido?" />
    <serviceTask id="p01_a5" name="Mostrar error: archivo no soportado" />
    <endEvent id="p01_e1" name="Fin: archivo rechazado" />
    <serviceTask id="p01_a6" name="Mostrar vista previa de la imagen" />
    <serviceTask id="p01_a7" name="Enviar a POST /predict y mostrar 'Esperando imagen...'" />
    <boundaryEvent id="p01_bt" name="Timeout 10 s" attachedToRef="p01_a7" cancelActivity="true"><timerEventDefinition /></boundaryEvent>
    <intermediateCatchEvent id="p01_w1" name="Respuesta JSON del servicio"><messageEventDefinition /></intermediateCatchEvent>
    <exclusiveGateway id="p01_g5" name="¿Resultado de la respuesta?" />
    <serviceTask id="p01_a9" name="Mostrar 'Materiales Identificados' (contador, contenedor, pasos)" />
    <serviceTask id="p01_a10" name="Mostrar aviso: repetir foto (borrosa o confianza baja)" />
    <serviceTask id="p01_a8" name="Mostrar error de servicio / tiempo agotado y ofrecer reintento" />
    <endEvent id="p01_e2" name="Fin: usuario repite captura" />
    <endEvent id="p01_e3" name="Fin: error informado" />
    <userTask id="p01_u5" name="Revisar contenedor y pasos de preparación" />
    <exclusiveGateway id="p01_g6" name="¿Qué desea hacer?" />
    <userTask id="p01_u6" name="Alternar '¿Cómo Reciclar?' / '¿Cómo Reutilizar?'" />
    <userTask id="p01_u7" name="Abrir enlace de recurso externo" />
    <endEvent id="p01_e4" name="Fin: usuario informado" />
    <sequenceFlow id="p01_sf1" sourceRef="p01_s" targetRef="p01_a1" />
    <sequenceFlow id="p01_sf2" sourceRef="p01_a1" targetRef="p01_ga" />
    <sequenceFlow id="p01_sf3" sourceRef="p01_ga" targetRef="p01_b1" />
    <sequenceFlow id="p01_sf4" sourceRef="p01_ga" targetRef="p01_u1" />
    <sequenceFlow id="p01_sf5" sourceRef="p01_b1" targetRef="p01_b2" />
    <sequenceFlow id="p01_sf6" name="siguiente dato" sourceRef="p01_b2" targetRef="p01_b1" />
    <sequenceFlow id="p01_sf7" sourceRef="p01_u1" targetRef="p01_g1" />
    <sequenceFlow id="p01_sf8" name="Archivo" sourceRef="p01_g1" targetRef="p01_u2" />
    <sequenceFlow id="p01_sf9" name="Cámara" sourceRef="p01_g1" targetRef="p01_a2" />
    <sequenceFlow id="p01_sf10" sourceRef="p01_a2" targetRef="p01_g2" />
    <sequenceFlow id="p01_sf11" name="Sí" sourceRef="p01_g2" targetRef="p01_u3" />
    <sequenceFlow id="p01_sf12" name="No" sourceRef="p01_g2" targetRef="p01_a3" />
    <sequenceFlow id="p01_sf13" sourceRef="p01_a3" targetRef="p01_e0" />
    <sequenceFlow id="p01_sf14" sourceRef="p01_u3" targetRef="p01_g3" />
    <sequenceFlow id="p01_sf15" sourceRef="p01_u2" targetRef="p01_g3" />
    <sequenceFlow id="p01_sf16" sourceRef="p01_g3" targetRef="p01_a4" />
    <sequenceFlow id="p01_sf17" sourceRef="p01_a4" targetRef="p01_g4" />
    <sequenceFlow id="p01_sf18" name="Sí" sourceRef="p01_g4" targetRef="p01_a6" />
    <sequenceFlow id="p01_sf19" name="No" sourceRef="p01_g4" targetRef="p01_a5" />
    <sequenceFlow id="p01_sf20" sourceRef="p01_a5" targetRef="p01_e1" />
    <sequenceFlow id="p01_sf21" sourceRef="p01_a6" targetRef="p01_a7" />
    <sequenceFlow id="p01_sf22" sourceRef="p01_a7" targetRef="p01_w1" />
    <sequenceFlow id="p01_sf23" name="Sin respuesta" sourceRef="p01_bt" targetRef="p01_a8" />
    <sequenceFlow id="p01_sf24" sourceRef="p01_w1" targetRef="p01_g5" />
    <sequenceFlow id="p01_sf25" name="200 OK" sourceRef="p01_g5" targetRef="p01_a9" />
    <sequenceFlow id="p01_sf26" name="422 / baja confianza" sourceRef="p01_g5" targetRef="p01_a10" />
    <sequenceFlow id="p01_sf27" name="4xx / 5xx" sourceRef="p01_g5" targetRef="p01_a8" />
    <sequenceFlow id="p01_sf28" sourceRef="p01_a10" targetRef="p01_e2" />
    <sequenceFlow id="p01_sf29" sourceRef="p01_a8" targetRef="p01_e3" />
    <sequenceFlow id="p01_sf30" sourceRef="p01_a9" targetRef="p01_u5" />
    <sequenceFlow id="p01_sf31" sourceRef="p01_u5" targetRef="p01_g6" />
    <sequenceFlow id="p01_sf32" name="Alternar" sourceRef="p01_g6" targetRef="p01_u6" />
    <sequenceFlow id="p01_sf33" name="Recursos" sourceRef="p01_g6" targetRef="p01_u7" />
    <sequenceFlow id="p01_sf34" name="Terminar" sourceRef="p01_g6" targetRef="p01_e4" />
    <sequenceFlow id="p01_sf35" name="Escanear otro" sourceRef="p01_g6" targetRef="p01_u1" />
    <sequenceFlow id="p01_sf36" sourceRef="p01_u6" targetRef="p01_g6" />
    <sequenceFlow id="p01_sf37" sourceRef="p01_u7" targetRef="p01_g6" />
  </process>
  <process id="p02_pool2_proc" name="02 Servicio de inferencia: POST /predict" isExecutable="false">
    <documentation>AS-IS con extensiones propuestas - Pipeline completo de la API FastAPI: validaciones, nitidez, inferencia YOLOv8n-cls, umbral de confianza, catálogo y registro. Cubre RF-03 a RF-07, RNF-01, RNF-06, RNF-12.</documentation>
    <laneSet id="p02_pool2_ls">
      <lane id="p02_pool2_lane_1" name="API REST (FastAPI / uvicorn)">
        <flowNodeRef>p02_s</flowNodeRef>
        <flowNodeRef>p02_t1</flowNodeRef>
        <flowNodeRef>p02_g1</flowNodeRef>
        <flowNodeRef>p02_e1</flowNodeRef>
        <flowNodeRef>p02_t2</flowNodeRef>
        <flowNodeRef>p02_g2</flowNodeRef>
        <flowNodeRef>p02_e2</flowNodeRef>
        <flowNodeRef>p02_t3</flowNodeRef>
        <flowNodeRef>p02_g3</flowNodeRef>
        <flowNodeRef>p02_e3</flowNodeRef>
        <flowNodeRef>p02_a1</flowNodeRef>
        <flowNodeRef>p02_gj</flowNodeRef>
        <flowNodeRef>p02_e8</flowNodeRef>
      </lane>
      <lane id="p02_pool2_lane_2" name="Preprocesamiento de imagen">
        <flowNodeRef>p02_p1</flowNodeRef>
        <flowNodeRef>p02_g4</flowNodeRef>
        <flowNodeRef>p02_e4</flowNodeRef>
        <flowNodeRef>p02_p2</flowNodeRef>
        <flowNodeRef>p02_p3</flowNodeRef>
        <flowNodeRef>p02_g5</flowNodeRef>
        <flowNodeRef>p02_p4</flowNodeRef>
      </lane>
      <lane id="p02_pool2_lane_3" name="Modelo YOLOv8n-cls">
        <flowNodeRef>p02_m1</flowNodeRef>
        <flowNodeRef>p02_g6</flowNodeRef>
      </lane>
      <lane id="p02_pool2_lane_4" name="Catálogo y registro (BD)">
        <flowNodeRef>p02_d1</flowNodeRef>
        <flowNodeRef>p02_e5</flowNodeRef>
        <flowNodeRef>p02_d2</flowNodeRef>
        <flowNodeRef>p02_e6</flowNodeRef>
        <flowNodeRef>p02_d3</flowNodeRef>
        <flowNodeRef>p02_g7</flowNodeRef>
        <flowNodeRef>p02_e7</flowNodeRef>
        <flowNodeRef>p02_ga</flowNodeRef>
        <flowNodeRef>p02_d4</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p02_s" name="Recibir POST /predict (multipart/form-data)"><messageEventDefinition /></startEvent>
    <serviceTask id="p02_t1" name="Validar que exista el campo 'file'" />
    <exclusiveGateway id="p02_g1" name="¿Archivo presente?" />
    <endEvent id="p02_e1" name="Responder 400: falta archivo"><messageEventDefinition /></endEvent>
    <serviceTask id="p02_t2" name="Validar MIME, extensión y firma del archivo" />
    <exclusiveGateway id="p02_g2" name="¿Formato permitido?" />
    <endEvent id="p02_e2" name="Responder 415: formato no soportado"><messageEventDefinition /></endEvent>
    <serviceTask id="p02_t3" name="Verificar tamaño máximo (p. ej. 5 MB)" />
    <exclusiveGateway id="p02_g3" name="¿Tamaño permitido?" />
    <endEvent id="p02_e3" name="Responder 413: archivo demasiado grande"><messageEventDefinition /></endEvent>
    <serviceTask id="p02_p1" name="Decodificar imagen (Pillow / OpenCV)" />
    <exclusiveGateway id="p02_g4" name="¿Imagen decodificable?" />
    <endEvent id="p02_e4" name="Responder 422: imagen corrupta"><messageEventDefinition /></endEvent>
    <serviceTask id="p02_p2" name="Corregir orientación EXIF y convertir a RGB" />
    <serviceTask id="p02_p3" name="Calcular nitidez (varianza del Laplaciano)" />
    <exclusiveGateway id="p02_g5" name="¿Imagen nítida?" />
    <serviceTask id="p02_d1" name="Registrar inferencia: resultado BORROSA"><documentation>INSERT en tabla inferencia (resultado=BORROSA, nitidez_valor)</documentation></serviceTask>
    <endEvent id="p02_e5" name="Responder 422: foto borrosa, repetir captura"><messageEventDefinition /></endEvent>
    <serviceTask id="p02_p4" name="Redimensionar a 224×224 y normalizar" />
    <serviceTask id="p02_m1" name="Ejecutar inferencia YOLOv8n-cls (top-k)" />
    <exclusiveGateway id="p02_g6" name="¿Confianza top-1 ≥ umbral?" />
    <serviceTask id="p02_d2" name="Registrar inferencia: CONFIANZA_BAJA"><documentation>INSERT en inferencia + inferencia_topk</documentation></serviceTask>
    <endEvent id="p02_e6" name="Responder: clasificación insegura, repetir captura"><messageEventDefinition /></endEvent>
    <serviceTask id="p02_d3" name="Consultar catálogo: material, contenedor, pasos y enlaces"><documentation>SELECT material, contenedor, instruccion, paso_instruccion, recurso_externo</documentation></serviceTask>
    <exclusiveGateway id="p02_g7" name="¿Catálogo completo para el material?" />
    <endEvent id="p02_e7" name="Responder 503: material sin catálogo (brecha B-3)"><errorEventDefinition /></endEvent>
    <parallelGateway id="p02_ga" />
    <serviceTask id="p02_a1" name="Construir JSON (material, contenedor, pasos, enlaces)" />
    <serviceTask id="p02_d4" name="Registrar inferencia OK (material, confianza, latencia)"><documentation>INSERT en inferencia + inferencia_topk (RNF-12)</documentation></serviceTask>
    <parallelGateway id="p02_gj" />
    <endEvent id="p02_e8" name="Responder 200 OK con JSON"><messageEventDefinition /></endEvent>
    <sequenceFlow id="p02_sf1" sourceRef="p02_s" targetRef="p02_t1" />
    <sequenceFlow id="p02_sf2" sourceRef="p02_t1" targetRef="p02_g1" />
    <sequenceFlow id="p02_sf3" name="No" sourceRef="p02_g1" targetRef="p02_e1" />
    <sequenceFlow id="p02_sf4" name="Sí" sourceRef="p02_g1" targetRef="p02_t2" />
    <sequenceFlow id="p02_sf5" sourceRef="p02_t2" targetRef="p02_g2" />
    <sequenceFlow id="p02_sf6" name="No" sourceRef="p02_g2" targetRef="p02_e2" />
    <sequenceFlow id="p02_sf7" name="Sí" sourceRef="p02_g2" targetRef="p02_t3" />
    <sequenceFlow id="p02_sf8" sourceRef="p02_t3" targetRef="p02_g3" />
    <sequenceFlow id="p02_sf9" name="No" sourceRef="p02_g3" targetRef="p02_e3" />
    <sequenceFlow id="p02_sf10" name="Sí" sourceRef="p02_g3" targetRef="p02_p1" />
    <sequenceFlow id="p02_sf11" sourceRef="p02_p1" targetRef="p02_g4" />
    <sequenceFlow id="p02_sf12" name="No" sourceRef="p02_g4" targetRef="p02_e4" />
    <sequenceFlow id="p02_sf13" name="Sí" sourceRef="p02_g4" targetRef="p02_p2" />
    <sequenceFlow id="p02_sf14" sourceRef="p02_p2" targetRef="p02_p3" />
    <sequenceFlow id="p02_sf15" sourceRef="p02_p3" targetRef="p02_g5" />
    <sequenceFlow id="p02_sf16" name="No" sourceRef="p02_g5" targetRef="p02_d1" />
    <sequenceFlow id="p02_sf17" sourceRef="p02_d1" targetRef="p02_e5" />
    <sequenceFlow id="p02_sf18" name="Sí" sourceRef="p02_g5" targetRef="p02_p4" />
    <sequenceFlow id="p02_sf19" sourceRef="p02_p4" targetRef="p02_m1" />
    <sequenceFlow id="p02_sf20" sourceRef="p02_m1" targetRef="p02_g6" />
    <sequenceFlow id="p02_sf21" name="No" sourceRef="p02_g6" targetRef="p02_d2" />
    <sequenceFlow id="p02_sf22" sourceRef="p02_d2" targetRef="p02_e6" />
    <sequenceFlow id="p02_sf23" name="Sí" sourceRef="p02_g6" targetRef="p02_d3" />
    <sequenceFlow id="p02_sf24" sourceRef="p02_d3" targetRef="p02_g7" />
    <sequenceFlow id="p02_sf25" name="No" sourceRef="p02_g7" targetRef="p02_e7" />
    <sequenceFlow id="p02_sf26" name="Sí" sourceRef="p02_g7" targetRef="p02_ga" />
    <sequenceFlow id="p02_sf27" sourceRef="p02_ga" targetRef="p02_a1" />
    <sequenceFlow id="p02_sf28" sourceRef="p02_ga" targetRef="p02_d4" />
    <sequenceFlow id="p02_sf29" sourceRef="p02_a1" targetRef="p02_gj" />
    <sequenceFlow id="p02_sf30" sourceRef="p02_d4" targetRef="p02_gj" />
    <sequenceFlow id="p02_sf31" sourceRef="p02_gj" targetRef="p02_e8" />
  </process>
  <process id="p03_pool1_proc" name="03 Puntos Limpios RM: buscar un punto de reciclaje" isExecutable="false">
    <documentation>AS-IS con extensiones propuestas - Búsqueda de un punto limpio: carga del listado, filtro por comuna, revisión de tarjeta y decisión de acudir. Cubre RF-12 a RF-14.</documentation>
    <laneSet id="p03_pool1_ls">
      <lane id="p03_pool1_lane_1" name="Usuario">
        <flowNodeRef>p03_s</flowNodeRef>
        <flowNodeRef>p03_u1</flowNodeRef>
        <flowNodeRef>p03_u2</flowNodeRef>
        <flowNodeRef>p03_g1</flowNodeRef>
        <flowNodeRef>p03_u3</flowNodeRef>
        <flowNodeRef>p03_g2</flowNodeRef>
        <flowNodeRef>p03_u4</flowNodeRef>
        <flowNodeRef>p03_g3</flowNodeRef>
        <flowNodeRef>p03_g4</flowNodeRef>
        <flowNodeRef>p03_u5</flowNodeRef>
        <flowNodeRef>p03_u6</flowNodeRef>
        <flowNodeRef>p03_e1</flowNodeRef>
      </lane>
      <lane id="p03_pool1_lane_2" name="App EcoScan Chile">
        <flowNodeRef>p03_a1</flowNodeRef>
        <flowNodeRef>p03_g0</flowNodeRef>
        <flowNodeRef>p03_a0</flowNodeRef>
        <flowNodeRef>p03_e0</flowNodeRef>
        <flowNodeRef>p03_a2</flowNodeRef>
        <flowNodeRef>p03_a3</flowNodeRef>
      </lane>
      <lane id="p03_pool1_lane_3" name="Fuente de datos de puntos limpios">
        <flowNodeRef>p03_d1</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p03_s" name="Necesita reciclar un residuo" />
    <userTask id="p03_u1" name="Abrir pestaña 'Puntos Limpios RM'" />
    <serviceTask id="p03_a1" name="Solicitar listado de puntos limpios" />
    <serviceTask id="p03_d1" name="Entregar puntos activos (nombre, comuna, dirección, horario, materiales)"><documentation>SELECT punto_limpio JOIN comuna, horario_punto, punto_material</documentation></serviceTask>
    <exclusiveGateway id="p03_g0" name="¿Datos disponibles?" />
    <serviceTask id="p03_a0" name="Mostrar error: no se pudo cargar el listado" />
    <endEvent id="p03_e0" name="Fin: listado no disponible" />
    <serviceTask id="p03_a2" name="Mostrar tarjetas de todos los puntos (filtro 'Todas')" />
    <userTask id="p03_u2" name="Revisar comunas disponibles (chips de filtro)" />
    <exclusiveGateway id="p03_g1" name="¿Filtrar por comuna?" />
    <userTask id="p03_u3" name="Seleccionar chip de comuna" />
    <serviceTask id="p03_a3" name="Filtrar tarjetas por la comuna (sin recargar la página)" />
    <exclusiveGateway id="p03_g2" />
    <userTask id="p03_u4" name="Revisar tarjeta: dirección, horario y materiales aceptados" />
